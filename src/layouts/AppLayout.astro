---
import Link from "@components/Link.astro";
import { author, defaultMeta } from "@data/socials";

import navigation from "@data/navigation.json";
import ThemeToggle from "@components/ThemeToggle.astro";
import MusicPlayer from "@components/MusicPlayer.astro";
/*
 * Fonts: latin subsets only, and only the weights the design actually uses.
 * The previous eight full-family imports pulled in devanagari and latin-ext
 * for every weight, which inflated the render-blocking stylesheet.
 */
import "@fontsource/playfair-display/latin-400.css";
import "@fontsource/playfair-display/latin-700.css";
/* Real italic for the display voice: a browser-synthesised oblique on a
   high-contrast serif looks broken at hero sizes. Fetched only where used. */
import "@fontsource/playfair-display/latin-700-italic.css";
import "@fontsource/poppins/latin-400.css";
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-600.css";
/*
 * The two faces every page paints first: the serif of the wordmark and the
 * headings, and the body sans. Preloading them lets the browser fetch both
 * while it is still reading the head, instead of discovering them only after
 * the stylesheet has been parsed. These resolve to the same hashed files the
 * @font-face rules above point at, so nothing downloads twice.
 */
import playfairBold from "@fontsource/playfair-display/files/playfair-display-latin-700-normal.woff2?url";
import poppinsRegular from "@fontsource/poppins/files/poppins-latin-400-normal.woff2?url";
import Footer from "@components/Footer.astro";
import personPhoto from "../assets/data/harryhayman images/Harry-Hayman.jpg";
import geminiLogo from "../assets/data/entity_logos/gemini-hospitality-consultants.png";
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: {
    src: string;
    alt: string;
  };
  pubDate?: Date;
  tags?: string[];
  lastmod?: Date;
  /** Article pages get a calm background and a reading surface. */
  article?: boolean;
  /** Extra JSON-LD node(s) emitted alongside the site-wide graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
  /** The ventures logo row in the footer. The homepage carries its own. */
  footerVentures?: boolean;
  /** Keep this page out of search results (its links are still followed). */
  noindex?: boolean;
}

const {
  title,
  description: rawDescription = defaultMeta.description,
  ogImage = defaultMeta.ogImage,
  pubDate,
  tags = defaultMeta.keywords,
  lastmod,
  article = false,
  jsonLd = null,
  footerVentures = true,
  noindex = false,
} = Astro.props;

/* Contact is the one action in the bar, so it is drawn as a button. */
const navLinks = navigation.filter((item) => !item.cta);
const navAction = navigation.find((item) => item.cta);

/*
 * Results pages show about 155 characters of a description. Some posts carry
 * far more (one carried an entire article), which bloats every meta tag and
 * gets cut mid-word anyway, so anything longer is trimmed at a word boundary.
 */
const DESCRIPTION_MAX = 160;
const collapsed = rawDescription.replace(/\s+/g, " ").trim();
const description =
  collapsed.length <= DESCRIPTION_MAX
    ? collapsed
    : `${collapsed.slice(0, DESCRIPTION_MAX - 1).replace(/[\s,;:.]+\S*$/, "")}…`;

const pageTitle = title || defaultMeta.title;
const ogImageURL = new URL(ogImage.src, Astro.site).href;
/* The site banner and every generated post card are drawn at 1200x630.
   Declaring it lets social previews lay the card out before fetching it. */
const ogIsCard =
  ogImage.src === "/banner.png" || ogImage.src.startsWith("/image/");
/* Netlify serves pages with a trailing slash; the canonical says the same in
   every environment, dev included. Files (feeds, images) keep their name. */
const pathname = Astro.url.pathname;
const canonicalPath =
  pathname.endsWith("/") || /\.[a-z0-9]+$/i.test(pathname)
    ? pathname
    : `${pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site).href;
const date = pubDate || lastmod || new Date();
const formattedDate = date instanceof Date ? date.toISOString() : date;
const keywordsString = Array.isArray(tags) ? tags.join(", ") : tags;

const person = {
  "@type": "Person",
  "@id": "https://harryhayman.com/#person",
  name: "Harry Hayman",
  alternateName: "Harrison Graham Hayman IV",
  url: "https://harryhayman.com",
  /* A photograph of Harry, not the text banner, so a knowledge panel or a
     rich result has a face to show. */
  image: new URL(personPhoto.src, Astro.site).href,
  description:
    "Philadelphia business leader, hospitality entrepreneur, and philanthropist known for work in the restaurant industry and community development through Feed Philly Coalition and The Philadelphia Jazz Experience.",
  jobTitle: "Hospitality Entrepreneur and Community Leader",
  worksFor: { "@id": "https://harryhayman.com/#gemini" },
  homeLocation: {
    "@type": "Place",
    name: "Philadelphia, Pennsylvania",
  },
  founder: [
    { "@id": "https://harryhayman.com/#gemini" },
    {
      "@type": "Organization",
      name: "Philadelphia Jazz Experience",
      url: "https://philadelphiajazzexperience.org",
      description:
        "Preserving and promoting Philadelphia's rich jazz heritage",
    },
    {
      "@type": "Organization",
      name: "Veggie Graffiti",
      url: "https://veggiegraffiti.com",
      description:
        "Urban farming initiative combining hydroponic technology with sustainable practices",
    },
    {
      "@type": "Organization",
      name: "Feed Philly Coalition",
      url: "https://feedphillycoalition.org",
      description: "Community initiative addressing food insecurity",
    },
    {
      "@type": "Organization",
      name: "Harry Hayman Creative",
      url: "https://harryhaymancreative.com/",
      description:
        "Creative agency specializing in branding and marketing for hospitality businesses",
    },
    {
      "@type": "Organization",
      name: "Another Three Hearts Experience",
      url: "https://another3heartsexperience.com/",
      description:
        "Creating unique hospitality experiences combining culinary excellence with cultural enrichment",
    },
  ],
  /* I Am Hungry in Philadelphia is a documentary Harry produced, not an
     organisation he founded, so it is its own node below. Its old .org
     address no longer resolves; the film lives at iamhungryinphilly.com. */
  sameAs: [
    "https://www.facebook.com/HaymanHG/",
    "https://www.pinterest.com/hghayman1/",
    "https://www.instagram.com/harryhayman4",
    "https://x.com/HGHayman",
    "https://www.threads.com/@harryhayman4",
    "https://bsky.app/profile/harryhayman.bsky.social",
    "https://www.youtube.com/@harryhayman1467",
    "https://www.linkedin.com/in/harrisongrahamhaymaniv/",
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Philadelphia",
    addressRegion: "PA",
    addressCountry: "US",
  },
  knowsAbout: [
    "Restaurant Management",
    "Hospitality Industry",
    "Community Development",
    "Food Justice",
    "Jazz Music",
    "Philanthropy",
    "Business Consulting",
    "Urban Agriculture",
    "Creative Marketing",
  ],
};

const organization = {
  "@type": "Organization",
  "@id": "https://harryhayman.com/#gemini",
  name: "Gemini Hospitality Consultants",
  url: "https://harryhaymangemini.com/",
  logo: new URL(geminiLogo.src, Astro.site).href,
  description:
    "Strategic consulting services for restaurants and hospitality businesses, focusing on innovative solutions and sustainable growth.",
  founder: { "@id": "https://harryhayman.com/#person" },
  areaServed: {
    "@type": "City",
    name: "Philadelphia",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Philadelphia",
    addressRegion: "PA",
    addressCountry: "US",
  },
  sameAs: [
    "https://www.linkedin.com/company/gemini-hospitality-consultants",
    "https://www.instagram.com/geminihospitalityconsulting/",
  ],
};

const website = {
  "@type": "WebSite",
  "@id": "https://harryhayman.com/#website",
  url: "https://harryhayman.com",
  name: "Harry Hayman",
  description: defaultMeta.description,
  inLanguage: "en-US",
  publisher: { "@id": "https://harryhayman.com/#person" },
};

const documentary = {
  "@type": "Movie",
  "@id": "https://harryhayman.com/#i-am-hungry-in-philadelphia",
  name: "I Am Hungry In Philadelphia",
  url: "https://iamhungryinphilly.com/",
  description:
    "A documentary film exploring hunger in Philadelphia, produced by Harry Hayman.",
  producer: { "@id": "https://harryhayman.com/#person" },
};

const extraNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const graph = {
  "@context": "https://schema.org",
  "@graph": [person, organization, website, documentary, ...extraNodes],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <link
      rel="preload"
      href={playfairBold}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={poppinsRegular}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <!-- SEO Tags -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    {
      ogIsCard && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:site_name" content={author} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@HGHayman" />
    <meta name="twitter:creator" content="@HGHayman" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImage.alt} />
    <meta name="twitter:domain" content="harryhayman.com" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#1B6FBF"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0C121B"
    />
    <meta name="msapplication-TileColor" content="#1B6FBF" />
    <meta name="apple-mobile-web-app-title" content="Harry Hayman" />
    <meta name="application-name" content="Harry Hayman" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large"}
    />
    <meta name="author" content={author} />
    <meta name="date" content={formattedDate} />
    <meta name="keywords" content={keywordsString} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Harry Hayman"
      href="/rss.xml"
    />

    <!-- Theme initialization: must stay inline and first-paint blocking -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        var prefersDark =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        var theme = stored || (prefersDark ? "dark" : "light");
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.style.colorScheme = theme;
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <!-- Scroll reveal: replaces the AOS library and its stylesheet -->
    <style is:inline>
      [data-aos] {
        opacity: 0;
        transition:
          opacity 0.55s ease-out,
          transform 0.55s ease-out;
      }
      [data-aos="fade-up"] {
        transform: translateY(16px);
      }
      [data-aos="fade-right"] {
        transform: translateX(-18px);
      }
      [data-aos="fade-left"] {
        transform: translateX(18px);
      }
      [data-aos="zoom-in"] {
        transform: scale(0.97);
      }
      [data-aos].is-revealed {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        [data-aos] {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
      }
    </style>
    <noscript
      ><style>
        [data-aos] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style></noscript
    >

    <!-- Analytics: third party, kept off the critical path -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://tracker.metricool.com" />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-D67B4Z3VNH");

      (function () {
        function loadAnalytics() {
          var ga = document.createElement("script");
          ga.async = true;
          ga.src = "https://www.googletagmanager.com/gtag/js?id=G-D67B4Z3VNH";
          document.head.appendChild(ga);

          var mc = document.createElement("script");
          mc.async = true;
          mc.src = "https://tracker.metricool.com/resources/be.js";
          mc.onload = function () {
            try {
              if (typeof beTracker !== "undefined") {
                beTracker.t({ hash: "f9fe076de289567c484620078e1d3423" });
              }
            } catch (e) {}
          };
          mc.onerror = function () {};
          document.head.appendChild(mc);
        }
        if ("requestIdleCallback" in window) {
          requestIdleCallback(loadAnalytics, { timeout: 3000 });
        } else {
          window.addEventListener("load", function () {
            setTimeout(loadAnalytics, 1200);
          });
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class:list={[article && "reading-mode"]}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <div
      class="flex flex-col min-h-screen text-[rgb(var(--text-primary))] relative z-10"
    >
      <!-- Navigation -->
      <nav class="sticky top-0 z-50 site-nav" aria-label="Primary">
        <div class="wrap">
          <div class="nav-bar">
            <a href="/" class="wordmark text-base sm:text-lg">
              <span class="sm:hidden" aria-hidden="true">HH</span>
              <span class="sr-only sm:not-sr-only">Harry Hayman</span>
            </a>
            <ul class="nav-links">
              {
                navLinks.map((item) => (
                  <li class:list={[item.mobileHidden && "hidden md:block"]}>
                    <Link href={item.href} text={item.text} />
                  </li>
                ))
              }
            </ul>
            {
              navAction && (
                <a
                  href={navAction.href}
                  class="nav-cta"
                  aria-current={
                    `${Astro.url.pathname.replace(/\/+$/, "")}/`.startsWith(
                      navAction.href,
                    )
                      ? "page"
                      : undefined
                  }
                >
                  <span class="sm:hidden">{navAction.text}</span>
                  <span class="hidden sm:inline">{navAction.label}</span>
                </a>
              )
            }
          </div>
        </div>
      </nav>

      <!-- Theme Toggle -->
      <ThemeToggle />

      <!-- Main Content -->
      <main id="main" class="flex-grow">
        <slot />
      </main>

      <!-- Music Player -->
      <MusicPlayer />

      <!-- Footer -->
      <Footer ventures={footerVentures} />
    </div>

    <script is:inline>
      (function () {
        var els = document.querySelectorAll("[data-aos]");
        if (!els.length) return;
        var reduce =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!("IntersectionObserver" in window) || reduce) {
          for (var i = 0; i < els.length; i++) {
            els[i].classList.add("is-revealed");
          }
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var delay = entry.target.getAttribute("data-aos-delay");
              if (delay) {
                entry.target.style.transitionDelay =
                  Math.min(parseInt(delay, 10) || 0, 400) + "ms";
              }
              entry.target.classList.add("is-revealed");
              io.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -6% 0px", threshold: 0.04 },
        );
        for (var j = 0; j < els.length; j++) {
          io.observe(els[j]);
        }
      })();
    </script>
  </body>
</html>
