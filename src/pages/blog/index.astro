---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
import { getCollection } from "astro:content";
import BlogCard from "@components/BlogCard.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(posts.map((post) => post.data.category))]
  .filter((category): category is string => typeof category === "string")
  .sort((a, b) => a.localeCompare(b));

/*
 * Places in Philadelphia that Harry has already written about on this site.
 * Every entry is resolved against the real blog collection, so a room only
 * appears if a post about it actually exists. Nothing is claimed about these
 * venues beyond linking to Harry's own write-up.
 */
const placeNames = [
  "Unit Su Vege",
  "Fabrika",
  "Frankie's Summer Club",
  "Calder Gardens",
  "Kimmel Center",
  "Drexel Food Lab",
];

const normalise = (value: string) =>
  value.toLowerCase().replace(/[^a-z0-9]+/g, " ");

type Post = (typeof posts)[number];

const places = placeNames
  .map((name) => {
    const needle = normalise(name).trim();
    const match = posts.find(
      (post) =>
        normalise(post.data.title).includes(needle) ||
        normalise(post.slug).includes(needle),
    );
    return match ? { name, post: match } : null;
  })
  .filter((entry): entry is { name: string; post: Post } => Boolean(entry));
---

<AppLayout
  title="Blog | Harry Hayman on Philadelphia Hospitality and Jazz"
  description="Harry Hayman writes about Philadelphia restaurants, jazz nights, food security and community, with reviews and reflections from the city he works in."
>
  <div class="py-12 sm:py-16 max-w-5xl mx-auto">
    <!-- Header -->
    <header class="text-center mb-10">
      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold mb-4 text-[rgb(var(--text-primary))]"
      >
        Blog & Insights
      </h1>
      <p class="text-[rgb(var(--text-secondary))] text-lg max-w-2xl mx-auto">
        Harry Hayman on Philadelphia hospitality, jazz, food security and the
        people building the city.
      </p>
    </header>

    <!-- Places Harry has written about: crawlable, descriptive internal links -->
    {
      places.length > 0 && (
        <section
          class="card mx-auto mb-12 rounded-2xl p-6 sm:p-8"
          aria-labelledby="places-heading"
        >
          <h2
            id="places-heading"
            class="mb-2 font-serif text-xl font-bold text-[rgb(var(--text-primary))] sm:text-2xl"
          >
            Philadelphia places Harry has written about
          </h2>
          <p class="mb-5 text-sm text-[rgb(var(--text-secondary))]">
            Rooms, restaurants and stages covered on this blog.
          </p>
          <ul class="grid gap-4 sm:grid-cols-2">
            {places.map(({ name, post }) => (
              <li>
                <a
                  href={`/blog/${post.slug}`}
                  class="group block h-full rounded-lg border border-[rgb(var(--nav-border))] p-4 transition-colors hover:border-brand-400 hover:bg-[rgb(var(--accent-soft))]"
                >
                  <span class="block font-semibold text-[rgb(var(--text-primary))] group-hover:text-[rgb(var(--accent))]">
                    {name}
                  </span>
                  <span class="mt-1 block text-sm text-[rgb(var(--text-secondary))]">
                    {post.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Categories -->
    {
      categories.length > 0 && (
        <section class="mb-12" aria-labelledby="categories-heading">
          <h2
            id="categories-heading"
            class="mb-4 text-center text-sm font-semibold uppercase tracking-[0.18em] text-[rgb(var(--text-muted))]"
          >
            Browse by topic
          </h2>
          <div class="flex flex-wrap justify-center gap-2">
            {categories.map((category) => (
              <a
                href={`/blog/category/${category}`}
                class="rounded-full border border-[rgb(var(--nav-border))] bg-[rgb(var(--card-bg))] px-3.5 py-1.5 text-sm font-medium text-[rgb(var(--text-secondary))] transition-colors hover:border-brand-400 hover:bg-[rgb(var(--accent-soft))] hover:text-[rgb(var(--accent))]"
              >
                {category}
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- Blog Posts Grid -->
    <h2 class="sr-only">All posts</h2>
    <div class="grid gap-8 md:grid-cols-2">
      {
        posts.map((post, index) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            image={post.data.image}
            category={post.data.category ?? undefined}
            href={`/blog/${post.slug}`}
            priority={index < 2}
          />
        ))
      }
    </div>

    <!-- Empty State -->
    {
      posts.length === 0 && (
        <div class="text-center py-12">
          <p class="text-[rgb(var(--text-primary))] text-lg">No posts found.</p>
        </div>
      )
    }
  </div>
</AppLayout>
