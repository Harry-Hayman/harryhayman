---
export const prerender = true;

import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import AppLayout from "@layouts/AppLayout.astro";
import { absolute, categoryPath, postPath } from "../../lib/paths";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      // Newest first, so the previous array item is the newer post.
      newer: index > 0 ? posts[index - 1] : undefined,
      older: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await post.render();

const publishedISO = post.data.pubDate.toISOString();
const modifiedISO = (
  post.data.updatedDate ||
  post.data.lastmod ||
  post.data.pubDate
).toISOString();

const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

/* Derived from the body that is already on the page, not a claim about it. */
const words = (post.body || "").split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 220));

const canonical = absolute(postPath(post.slug));

/* The hero's frame is sized from the image's own proportions, so the page
   reserves its space before the picture arrives. With width and height both
   left to auto, the frame was empty until load and the whole article jumped
   (CLS 0.41 on mobile). */
const hero = post.data.image;
const heroRatio = hero ? (hero.width / hero.height).toFixed(4) : null;
const heroWidths = hero
  ? [480, 720, 960, 1440].filter((w) => w <= hero.width)
  : [];

const articleSchema = {
  "@type": "BlogPosting",
  "@id": `${canonical}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedISO,
  dateModified: modifiedISO,
  mainEntityOfPage: canonical,
  url: canonical,
  inLanguage: "en-US",
  articleSection: post.data.category || undefined,
  keywords:
    post.data.tags && post.data.tags.length
      ? post.data.tags.join(", ")
      : undefined,
  /* Named inline as well as by reference, so a parser that reads this
     object on its own still finds a real author. */
  author: {
    "@type": "Person",
    "@id": "https://harryhayman.com/#person",
    name: "Harry Hayman",
    url: "https://harryhayman.com/about",
  },
  publisher: { "@id": "https://harryhayman.com/#person" },
  /* The generated share card: Article results need an image to qualify. */
  image: new URL(`/image/${post.slug}.png`, Astro.site).href,
  wordCount: words,
};

/* The same trail the visible breadcrumb shows, for the results page. */
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumb`,
  itemListElement: [
    { name: "Home", item: absolute("/") },
    { name: "Blog", item: absolute("/blog/") },
    ...(post.data.category
      ? [{ name: post.data.category, item: absolute(categoryPath(post.data.category)) }]
      : []),
    { name: post.data.title },
  ].map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    ...crumb,
  })),
};

/*
 * Past about 60 characters a results page cuts the title off, and the part
 * it cuts is the " | Harry Hayman" suffix. Results already show the site
 * name from the WebSite markup, so a long headline goes out on its own
 * instead of ending in an ellipsis, and a headline that already names Harry
 * does not name him twice. A post can carry a shorter `seoTitle` for results
 * pages; the full title stays as the headline on the page.
 */
const searchTitle = post.data.seoTitle || post.data.title;
const suffixedTitle = `${searchTitle} | Harry Hayman`;
const pageTitle =
  !/harry hayman/i.test(searchTitle) && suffixedTitle.length <= 60
    ? suffixedTitle
    : searchTitle;
---

<AppLayout
  title={pageTitle}
  description={post.data.description}
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  article={true}
  jsonLd={[articleSchema, breadcrumbSchema]}
  ogImage={{
    src: `/image/${post.slug}.png`,
    alt: `${post.data.title}, by Harry Hayman`,
  }}
>
  <article class="wrap py-8 sm:py-12">
    <!-- Breadcrumb: orientation for readers and crawlers -->
    <nav
      aria-label="Breadcrumb"
      class="mx-auto mb-8 max-w-3xl text-sm text-[rgb(var(--text-muted))] lg:max-w-[54rem]"
    >
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-[rgb(var(--accent))]">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/blog/" class="hover:text-[rgb(var(--accent))]">Blog</a></li>
        {
          post.data.category && (
            <>
              <li aria-hidden="true">/</li>
              <li>
                <a
                  href={categoryPath(post.data.category)}
                  class="hover:text-[rgb(var(--accent))]"
                >
                  {post.data.category}
                </a>
              </li>
            </>
          )
        }
      </ol>
    </nav>

    <header class="mx-auto mb-10 max-w-3xl lg:max-w-[54rem]">
      {
        post.data.category && (
          <a
            href={categoryPath(post.data.category)}
            class="chip chip-accent text-[0.75rem] uppercase tracking-[0.14em]"
          >
            {post.data.category}
          </a>
        )
      }
      <h1 class="display-2 mt-5 text-[rgb(var(--text-primary))]">
        {post.data.title}
      </h1>
      <p class="lede mt-5">{post.data.description}</p>
      <div
        class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-[rgb(var(--nav-border))] pt-5 text-sm text-[rgb(var(--text-muted))]"
      >
        <span class="font-medium text-[rgb(var(--text-secondary))]">
          By <a href="/about/" rel="author" class="underline decoration-[rgb(var(--rule-strong))] underline-offset-4 hover:text-[rgb(var(--accent))]">Harry Hayman</a>
        </span>
        <span aria-hidden="true">&middot;</span>
        <time datetime={publishedISO}>{formattedDate}</time>
        <span aria-hidden="true">&middot;</span>
        <span>{readingMinutes} min read</span>
      </div>
    </header>

    <!-- The frame hugs the picture. A fixed-width frame turned every portrait
         hero into a thin image floating in a mat wider than itself; a
         landscape hero still fills the whole column. -->
    {
      hero && (
        <figure
          class="mx-auto mb-10 max-w-3xl lg:max-w-[54rem]"
          style={`--hero-ar: ${heroRatio}`}
        >
          <div class="post-hero-frame">
            <Image
              src={hero}
              alt={post.data.title}
              widths={heroWidths.length ? heroWidths : [hero.width]}
              format="webp"
              quality={68}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              sizes="(max-width: 1024px) 100vw, 864px"
              class="post-hero-img"
            />
          </div>
        </figure>
      )
    }

    <!-- Calm, high contrast reading surface -->
    <div
      class="reading-surface mx-auto max-w-3xl px-5 py-8 sm:px-10 sm:py-12 lg:max-w-[54rem] lg:px-12"
    >
      <div class="prose mx-auto">
        <Content />
      </div>
    </div>

    <!-- Continue reading -->
    {
      (newer || older) && (
        <nav
          aria-label="More posts"
          class="mx-auto mt-12 grid max-w-3xl gap-4 sm:grid-cols-2 lg:max-w-[54rem]"
        >
          {newer ? (
            <a
              href={postPath(newer.slug)}
              class="card card-link group flex flex-col p-5"
            >
              <span class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-[rgb(var(--text-muted))]">
                Newer post
              </span>
              <span class="mt-2 font-serif font-bold leading-snug text-[rgb(var(--text-primary))] transition-colors group-hover:text-[rgb(var(--accent))]">
                {newer.data.title}
              </span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          )}
          {older && (
            <a
              href={postPath(older.slug)}
              class="card card-link group flex flex-col p-5 sm:text-right"
            >
              <span class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-[rgb(var(--text-muted))]">
                Older post
              </span>
              <span class="mt-2 font-serif font-bold leading-snug text-[rgb(var(--text-primary))] transition-colors group-hover:text-[rgb(var(--accent))]">
                {older.data.title}
              </span>
            </a>
          )}
        </nav>
      )
    }

    <div class="mx-auto mt-10 max-w-3xl text-center lg:max-w-[54rem]">
      <a href="/blog/" class="btn btn-secondary">
        Back to all of Harry's writing
      </a>
    </div>
  </article>
</AppLayout>

<style is:global>
  /* Article typography. The body sits on an opaque surface so nothing ever
     crawls under the copy.

     Measure: 68ch on phones and tablets, opening out to a full editorial
     column from the large breakpoint up. At 640px the column was leaving most
     of a desktop screen empty and the article read as a narrow strip. */
  .reading-surface .prose {
    max-width: 68ch;
  }

  @media (min-width: 1024px) {
    .reading-surface .prose {
      max-width: 48rem;
    }
  }

  /* Hero frame: the picture's own proportions, never taller than the
     viewport can comfortably show, centred, so a portrait hero is not
     stretched across the column. */
  .post-hero-frame {
    --hero-max-h: 34rem;
    width: min(100%, calc(var(--hero-max-h) * var(--hero-ar)));
    aspect-ratio: var(--hero-ar);
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--r-lg);
    border: 1px solid rgb(var(--nav-border));
    background-color: rgb(var(--surface-sunken));
    box-shadow: var(--shadow-2);
  }

  @media (min-width: 1024px) {
    .post-hero-frame {
      --hero-max-h: 38rem;
    }
  }

  .post-hero-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reading-surface .prose > :first-child {
    margin-top: 0;
  }

  .reading-surface .prose > :last-child {
    margin-bottom: 0;
  }

  /* The opening paragraph carries a touch more weight, the way a printed
     feature sets its first line apart from the rest of the column. */
  .reading-surface .prose > p:first-of-type {
    font-size: 1.1875rem;
    line-height: 1.7;
    color: rgb(var(--text-primary));
  }

  .prose img {
    border-radius: var(--r-md);
    max-width: 100%;
    height: auto;
    object-fit: contain;
    margin: 2rem auto;
    display: block;
  }

  .prose figure,
  .prose picture {
    margin: 2rem auto;
  }

  .prose pre {
    background-color: rgb(var(--surface-raised));
    border: 1px solid rgb(var(--nav-border));
  }

  .prose blockquote {
    padding: 1rem 1.25rem;
  }
</style>
