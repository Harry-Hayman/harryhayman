---
export const prerender = true;

import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import AppLayout from "@layouts/AppLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      // Newest first, so the previous array item is the newer post.
      newer: index > 0 ? posts[index - 1] : undefined,
      older: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await post.render();

const publishedISO = post.data.pubDate.toISOString();
const modifiedISO = (
  post.data.updatedDate ||
  post.data.lastmod ||
  post.data.pubDate
).toISOString();

const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const canonical = new URL(`/blog/${post.slug}`, Astro.site).href;

const articleSchema = {
  "@type": "BlogPosting",
  "@id": `${canonical}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedISO,
  dateModified: modifiedISO,
  mainEntityOfPage: canonical,
  url: canonical,
  inLanguage: "en-US",
  articleSection: post.data.category || undefined,
  keywords:
    post.data.tags && post.data.tags.length
      ? post.data.tags.join(", ")
      : undefined,
  author: { "@id": "https://harryhayman.com/#person" },
  publisher: { "@id": "https://harryhayman.com/#person" },
};
---

<AppLayout
  title={`${post.data.title} | Harry Hayman`}
  description={post.data.description}
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  article={true}
  jsonLd={articleSchema}
  ogImage={{
    src: `/image/${post.slug}.png`,
    alt: `${post.data.title}, by Harry Hayman`,
  }}
>
  <article class="py-8 sm:py-12">
    <!-- Breadcrumb: orientation for readers and crawlers -->
    <nav
      aria-label="Breadcrumb"
      class="mx-auto mb-6 max-w-3xl text-sm text-[rgb(var(--text-muted))]"
    >
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-[rgb(var(--accent))]">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/blog" class="hover:text-[rgb(var(--accent))]">Blog</a></li>
        {
          post.data.category && (
            <>
              <li aria-hidden="true">/</li>
              <li>
                <a
                  href={`/blog/category/${post.data.category}`}
                  class="hover:text-[rgb(var(--accent))]"
                >
                  {post.data.category}
                </a>
              </li>
            </>
          )
        }
      </ol>
    </nav>

    <header class="mx-auto mb-8 max-w-3xl text-center">
      {
        post.data.category && (
          <a
            href={`/blog/category/${post.data.category}`}
            class="mb-4 inline-block rounded-full bg-[rgb(var(--button-primary))] px-4 py-1 text-sm font-medium text-[rgb(var(--button-on))]"
          >
            {post.data.category}
          </a>
        )
      }
      <h1
        class="mb-4 font-serif text-3xl font-bold leading-tight text-[rgb(var(--text-primary))] sm:text-4xl md:text-5xl"
      >
        {post.data.title}
      </h1>
      <p class="text-[rgb(var(--text-secondary))]">
        By Harry Hayman
        <span aria-hidden="true">&middot;</span>
        <time datetime={publishedISO}>{formattedDate}</time>
      </p>
    </header>

    {
      post.data.image && (
        <figure class="mx-auto mb-10 max-w-3xl">
          <Image
            src={post.data.image}
            alt={post.data.title}
            width={860}
            format="webp"
            quality={68}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            sizes="(max-width: 768px) 100vw, 768px"
            class="mx-auto h-auto max-h-[560px] w-auto max-w-full rounded-2xl object-contain"
          />
        </figure>
      )
    }

    <!-- Calm, high contrast reading surface -->
    <div class="reading-surface mx-auto max-w-3xl px-5 py-8 sm:px-10 sm:py-12">
      <div class="prose mx-auto">
        <Content />
      </div>
    </div>

    <!-- Continue reading -->
    {
      (newer || older) && (
        <nav
          aria-label="More posts"
          class="mx-auto mt-12 grid max-w-3xl gap-4 sm:grid-cols-2"
        >
          {newer ? (
            <a
              href={`/blog/${newer.slug}`}
              class="card group flex flex-col rounded-xl p-5 transition-colors hover:border-brand-400"
            >
              <span class="mb-1 text-xs uppercase tracking-wider text-[rgb(var(--text-muted))]">
                Newer post
              </span>
              <span class="font-serif font-semibold text-[rgb(var(--text-primary))] group-hover:text-[rgb(var(--accent))]">
                {newer.data.title}
              </span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          )}
          {older && (
            <a
              href={`/blog/${older.slug}`}
              class="card group flex flex-col rounded-xl p-5 transition-colors hover:border-brand-400 sm:text-right"
            >
              <span class="mb-1 text-xs uppercase tracking-wider text-[rgb(var(--text-muted))]">
                Older post
              </span>
              <span class="font-serif font-semibold text-[rgb(var(--text-primary))] group-hover:text-[rgb(var(--accent))]">
                {older.data.title}
              </span>
            </a>
          )}
        </nav>
      )
    }

    <div class="mx-auto mt-10 max-w-3xl text-center">
      <a href="/blog" class="btn btn-secondary">
        Back to all of Harry's writing
      </a>
    </div>
  </article>
</AppLayout>

<style is:global>
  /* Article typography. The measure is capped at 68ch and the body sits on an
     opaque surface so the ambient gradient never crawls under the copy. */
  .reading-surface .prose {
    max-width: 68ch;
  }

  .reading-surface .prose > :first-child {
    margin-top: 0;
  }

  .reading-surface .prose > :last-child {
    margin-bottom: 0;
  }

  .prose img {
    border-radius: 0.75rem;
    max-width: 100%;
    height: auto;
    object-fit: contain;
    margin: 2rem auto;
    display: block;
  }

  .prose figure,
  .prose picture {
    margin: 2rem auto;
  }

  .prose pre {
    background-color: rgb(var(--surface-raised));
    border: 1px solid rgb(var(--nav-border));
  }

  .prose blockquote {
    padding: 1rem 1.25rem;
  }
</style>
