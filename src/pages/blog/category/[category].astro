---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
import { getCollection } from "astro:content";
import BlogCard from "@components/BlogCard.astro";
import { absolute, categoryPath, categorySlug, postPath } from "../../../lib/paths";

/*
 * One archive per category, served at its lowercase name. The capitalised
 * paths these pages used to be built at were 301'd to lowercase by Netlify,
 * so the sitemap and every category link pointed at a redirect and each
 * page declared the redirecting URL as its own canonical. Names that differ
 * only by case share one archive.
 */
export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
  const groups = new Map<string, { name: string; posts: typeof posts }>();

  for (const post of posts) {
    const name = post.data.category;
    if (typeof name !== "string" || !name.trim()) continue;
    const key = categorySlug(name);
    const group = groups.get(key) ?? { name: name.trim(), posts: [] };
    group.posts.push(post);
    groups.set(key, group);
  }

  return [...groups.entries()].map(([key, group]) => ({
    params: { category: key },
    props: { posts: group.posts, category: group.name },
  }));
}

interface Props {
  posts: any[];
  category: string;
}

const { posts, category } = Astro.props;
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

/*
 * An archive that lists one or two posts is a thin copy of those posts.
 * It stays reachable for readers, but asks search engines not to index it
 * (the sitemap leaves it out for the same reason) until the topic grows.
 */
const THIN_ARCHIVE = 3;
const thin = sortedPosts.length < THIN_ARCHIVE;

const collectionPage = {
  "@type": "CollectionPage",
  "@id": `${absolute(categoryPath(category))}#collection`,
  url: absolute(categoryPath(category)),
  name: `Harry Hayman on ${category}`,
  isPartOf: { "@id": "https://harryhayman.com/#website" },
  about: category,
  inLanguage: "en-US",
};
---

<AppLayout
  title={`Harry Hayman on ${category} | Philadelphia Blog`}
  description={`Harry Hayman's writing on ${category.toLowerCase()} in Philadelphia: ${sortedPosts.length} ${sortedPosts.length === 1 ? "post" : "posts"} on hospitality, culture and community.`}
  noindex={thin}
  jsonLd={collectionPage}
>
  <!-- Header -->
  <section class="wrap pt-12 sm:pt-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-[rgb(var(--text-muted))]">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-[rgb(var(--accent))]">Home</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/blog/" class="hover:text-[rgb(var(--accent))]">Blog</a>
        </li>
      </ol>
    </nav>
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker">Topic</p>
        <h1 class="display-2 mt-5">{category}</h1>
      </div>
      <div class="lg:col-span-5">
        <p class="lede">
          Harry Hayman's articles and insights about {category.toLowerCase()}.
        </p>
        <p class="meta mt-3">{sortedPosts.length} posts</p>
      </div>
    </div>
    <hr class="rule mt-10" />
  </section>

  <!-- Blog Posts Grid -->
  <section class="wrap section-tight">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        sortedPosts.map((post, index) => (
          <div class="h-full" data-aos="fade-up" data-aos-delay={(index % 3) * 70}>
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              image={post.data.image}
              category={post.data.category}
              href={postPath(post.slug)}
              priority={index < 3}
            />
          </div>
        ))
      }
    </div>

    <!-- Empty State -->
    {
      sortedPosts.length === 0 && (
        <div class="py-12 text-center">
          <p class="text-lg text-[rgb(var(--text-primary))]">
            No posts found in this category.
          </p>
        </div>
      )
    }

    <div class="mt-12 text-center">
      <a href="/blog/" class="btn btn-secondary">Back to all posts</a>
    </div>
  </section>
</AppLayout>
