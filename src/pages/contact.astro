---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
import { Image } from "astro:assets";
import harryImage from "../assets/data/harryhayman images/Harry-Hayman.jpg";

/*
 * Direct contact, no form.
 *
 * Every value below already existed in this repository before this page was
 * rewritten, and every one of them is something Harry published himself:
 *
 *   email    src/assets/blogs/2021-10-16-Be-sure-to-check-out-my-highlights-at-
 *            the-top-of-t/2021-10-16_18-34-16_UTC.txt
 *            ("If you have any questions please contact me via email ...")
 *   phone    src/content/blog/harry-hayman-workmerk-virussafepro-saving-the-
 *            world.mdx and the 2020-05-06 caption in src/assets/blogs
 *            ("give me a call anytime: 215-406-0774")
 *   socials  the sameAs list in the site-wide JSON-LD graph (AppLayout)
 *   city     the PostalAddress in the same graph
 *
 * Nothing here is invented. If a detail is not in the repository it is not
 * on this page.
 */
const email = "hghayman4@aol.com";
const phoneDisplay = "215-406-0774";
const phoneHref = "tel:+12154060774";

const directLines = [
  {
    label: "Email",
    value: email,
    href: `mailto:${email}`,
    note: "The fastest way to reach Harry directly.",
    icon: "M3 7.5A1.5 1.5 0 0 1 4.5 6h15A1.5 1.5 0 0 1 21 7.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5v-9Zm.75.75 7.53 5.02a1.5 1.5 0 0 0 1.66 0l7.53-5.02",
  },
  {
    label: "Phone",
    value: phoneDisplay,
    href: phoneHref,
    note: "Calls about consulting, speaking and the initiatives.",
    icon: "M4.5 5.25A1.5 1.5 0 0 1 6 3.75h1.86a1.5 1.5 0 0 1 1.45 1.12l.6 2.34a1.5 1.5 0 0 1-.4 1.45l-1.2 1.2a12 12 0 0 0 5.28 5.28l1.2-1.2a1.5 1.5 0 0 1 1.45-.4l2.34.6a1.5 1.5 0 0 1 1.12 1.45V18a1.5 1.5 0 0 1-1.5 1.5A14.25 14.25 0 0 1 4.5 5.25Z",
  },
  {
    label: "Based in",
    value: "Philadelphia, Pennsylvania",
    href: null,
    note: "Most of the work, and most of the meetings, happen in the city.",
    icon: "M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z",
  },
];

/*
 * Reasons to write, drawn from what already exists on this site: consulting
 * through Gemini, the community initiatives, the speaking Harry already does,
 * and the creative studio. Nothing new is promised on his behalf.
 */
const topics = [
  {
    title: "Hospitality consulting",
    body: "Restaurant and hospitality work through Gemini Hospitality Consultants.",
  },
  {
    title: "Community initiatives",
    body: "Feed Philly Coalition, I Am Hungry in Philly and the Philadelphia Jazz Experience.",
  },
  {
    title: "Speaking",
    body: "Talks for universities, conferences and Philadelphia organisations.",
  },
  {
    title: "Creative collaboration",
    body: "Branding, marketing and storytelling through Harry Hayman Creative.",
  },
];

/* The same accounts the site-wide graph already lists as Harry's. */
