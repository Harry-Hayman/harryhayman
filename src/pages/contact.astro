/* Contact details as structured data, using the same values shown on the page. */
const contactSchema = {
  "@type": "ContactPage",
  "@id": "https://harryhayman.com/contact#contactpage",
  url: "https://harryhayman.com/contact",
  name: "Contact Harry Hayman",
  about: { "@id": "https://harryhayman.com/#person" },
  mainEntity: {
    "@type": "ContactPoint",
    contactType: "Enquiries",
    email,
    telephone: "+1-215-406-0774",
    areaServed: "Philadelphia, PA",
    availableLanguage: "English",
  },
};
---

<AppLayout
  title="Contact Harry Hayman | Philadelphia"
  description="Get in touch with Harry Hayman about hospitality consulting, Philadelphia community initiatives, speaking engagements or creative collaboration."
  jsonLd={contactSchema}
>
  <!-- Header -->
  <section class="wrap pt-12 sm:pt-16">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker">Contact</p>
        <h1 class="display-2 mt-5">Get in touch</h1>
      </div>
      <div class="lg:col-span-5">
        <p class="lede">
          No forms. Email or call Harry directly, or find him on the accounts he
          actually posts on.
        </p>
      </div>
    </div>
    <hr class="rule mt-10" />
  </section>

  <!-- Direct lines -->
  <section class="wrap section-tight" aria-labelledby="direct-heading">
    <h2 id="direct-heading" class="sr-only">Direct contact details</h2>
    <ul class="grid gap-5 md:grid-cols-3">
      {
        directLines.map((line, index) => (
          <li class="h-full" data-aos="fade-up" data-aos-delay={index * 70}>
            {line.href ? (
              <a
                href={line.href}
                class="card card-link group flex h-full flex-col p-6 sm:p-7"
              >
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-field border border-[rgb(var(--nav-border))] bg-[rgb(var(--accent-soft))] text-[rgb(var(--accent))]">
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={line.icon}
                    />
                  </svg>
                </span>
                <span class="mt-5 block text-[0.75rem] font-semibold uppercase tracking-[0.18em] text-[rgb(var(--text-muted))]">
                  {line.label}
                </span>
                <span class="mt-2 block break-words font-serif text-[1.375rem] font-bold leading-tight text-[rgb(var(--text-primary))] transition-colors group-hover:text-[rgb(var(--accent))]">
                  {line.value}
                </span>
                <span class="mt-3 block text-sm leading-relaxed text-[rgb(var(--text-secondary))]">
                  {line.note}
                </span>
              </a>
            ) : (
              <div class="panel flex h-full flex-col p-6 sm:p-7">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-field border border-[rgb(var(--nav-border))] bg-[rgb(var(--accent-soft))] text-[rgb(var(--accent))]">
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={line.icon}
                    />
                  </svg>
                </span>
                <span class="mt-5 block text-[0.75rem] font-semibold uppercase tracking-[0.18em] text-[rgb(var(--text-muted))]">
                  {line.label}
                </span>
                <span class="mt-2 block font-serif text-[1.375rem] font-bold leading-tight text-[rgb(var(--text-primary))]">
                  {line.value}
                </span>
                <span class="mt-3 block text-sm leading-relaxed text-[rgb(var(--text-secondary))]">
                  {line.note}
                </span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Portrait, what to write about, and where else Harry publishes -->
  <section class="wrap section-tight pt-0">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <figure
          class="overflow-hidden rounded-card border border-[rgb(var(--nav-border))] shadow-2"
        >
          <Image
            src={harryImage}
            alt="Harry Hayman"
            class="h-64 w-full object-cover object-[center_22%] sm:h-80"
            loading="lazy"
            format="webp"
            quality={70}
            sizes="(max-width: 1024px) 100vw, 440px"
            width={900}
            height={1200}
          />
        </figure>

        <h2 class="heading-3 mt-8 text-[rgb(var(--text-primary))]">
          What people write about
        </h2>
        <ul class="mt-4">
          {
            topics.map((topic) => (
              <li class="border-t border-[rgb(var(--nav-border))] py-3.5">
                <p class="text-[0.9375rem] font-semibold text-[rgb(var(--text-primary))]">
                  {topic.title}
                </p>
                <p class="mt-1 text-sm leading-relaxed text-[rgb(var(--text-secondary))]">
                  {topic.body}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-7">
        <div class="card p-6 sm:p-8">
          <p class="kicker">Elsewhere</p>
          <h2 class="heading-3 mt-3 text-[rgb(var(--text-primary))]">
            Find Harry on social
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-[rgb(var(--text-secondary))]">
            A message on any of these reaches him too. The accounts below are
            the ones he posts from.
          </p>

          <ul class="mt-6">
            {
              socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="index-row group -mx-2 items-center rounded-field px-2"
                  >
                    <span class="inline-flex h-8 w-8 items-center justify-center rounded-field text-[rgb(var(--text-muted))] transition-colors group-hover:text-[rgb(var(--accent))]">
                      <svg
                        class="h-[18px] w-[18px]"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d={social.path} />
                      </svg>
                    </span>
                    <span class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                      <span class="font-serif text-[1.0625rem] font-bold text-[rgb(var(--text-primary))] transition-colors group-hover:text-[rgb(var(--accent))]">
                        {social.label}
                      </span>
                      <span class="meta break-all">{social.handle}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</AppLayout>
