---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
import { Image } from "astro:assets";
import harryImage from "../assets/data/harryhayman images/Harry-Hayman.jpg";

/*
 * Reasons to write, drawn from what already exists on this site: consulting
 * through Gemini, the community initiatives, the speaking Harry already does,
 * and the creative studio. Nothing new is promised on his behalf.
 */
const topics = [
  {
    title: "Hospitality consulting",
    body: "Restaurant and hospitality work through Gemini Hospitality Consultants.",
  },
  {
    title: "Community initiatives",
    body: "Feed Philly Coalition, I Am Hungry in Philly and the Philadelphia Jazz Experience.",
  },
  {
    title: "Speaking",
    body: "Talks for universities, conferences and Philadelphia organisations.",
  },
  {
    title: "Creative collaboration",
    body: "Branding, marketing and storytelling through Harry Hayman Creative.",
  },
];

const socials = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/harrisongrahamhaymaniv/",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/harryhayman4",
    path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z",
  },
  {
    label: "X",
    href: "https://x.com/HGHayman",
    path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  },
];

const fieldClass =
  "w-full min-h-[3rem] rounded-field border border-[rgb(var(--nav-border))] bg-[rgb(var(--surface))] px-4 py-3 text-[rgb(var(--text-primary))] placeholder:text-[rgb(var(--text-muted))] transition-colors focus:border-[rgb(var(--brand-500))] focus:outline-none focus:ring-2 focus:ring-[rgb(var(--ring))] focus:ring-offset-0";
---

<AppLayout
  title="Contact Harry Hayman | Philadelphia"
  description="Get in touch with Harry Hayman about hospitality consulting, Philadelphia community initiatives, speaking engagements or creative collaboration."
>
  <!-- Header -->
  <section class="wrap pt-12 sm:pt-16">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker">Contact</p>
        <h1 class="display-2 mt-5">Get in touch</h1>
      </div>
      <div class="lg:col-span-5">
        <p class="lede">
          Have a question or want to collaborate? Harry reads everything that
          comes through this form.
        </p>
      </div>
    </div>
    <hr class="rule mt-10" />
  </section>

  <section class="wrap section-tight">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- What to write about -->
      <div class="lg:col-span-5">
        <figure
          class="overflow-hidden rounded-card border border-[rgb(var(--nav-border))] shadow-2"
        >
          <Image
            src={harryImage}
            alt="Harry Hayman"
            class="h-64 w-full object-cover object-[center_22%] sm:h-80"
            loading="lazy"
            format="webp"
            quality={70}
            sizes="(max-width: 1024px) 100vw, 440px"
            width={900}
            height={1200}
          />
        </figure>

        <h2 class="heading-3 mt-8 text-[rgb(var(--text-primary))]">
          What people write about
        </h2>
        <ul class="mt-4">
          {
            topics.map((topic) => (
              <li class="border-t border-[rgb(var(--nav-border))] py-3.5">
                <p class="text-[0.9375rem] font-semibold text-[rgb(var(--text-primary))]">
                  {topic.title}
                </p>
                <p class="mt-1 text-sm leading-relaxed text-[rgb(var(--text-secondary))]">
                  {topic.body}
                </p>
              </li>
            ))
          }
        </ul>

        <div class="mt-6">
          <p
            class="text-xs font-semibold uppercase tracking-[0.18em] text-[rgb(var(--text-muted))]"
          >
            Elsewhere
          </p>
          <ul class="mt-3 flex items-center gap-1">
            {
              socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Harry Hayman on ${social.label}`}
                    title={`Harry Hayman on ${social.label}`}
                    class="inline-flex h-10 w-10 items-center justify-center rounded-field border border-[rgb(var(--nav-border))] text-[rgb(var(--text-secondary))] transition-colors hover:border-[rgb(var(--brand-400))] hover:bg-[rgb(var(--accent-soft))] hover:text-[rgb(var(--accent))]"
                  >
                    <svg
                      class="h-[18px] w-[18px]"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d={social.path} />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Form -->
      <div class="lg:col-span-7">
        <div class="card p-6 sm:p-8">
          <h2 class="heading-3 text-[rgb(var(--text-primary))]">
            Send Harry a message
          </h2>
          <p class="mt-2 text-sm text-[rgb(var(--text-secondary))]">
            Fields marked with an asterisk are required.
          </p>

          <form
            class="mt-7 space-y-5"
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
          >
            <p class="hidden">
              <label>
                Don't fill this out if you're human: <input name="bot-field" />
              </label>
            </p>

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="space-y-2">
                <label
                  class="block text-sm font-medium text-[rgb(var(--text-primary))]"
                  for="name"
                >
                  Name <span class="text-[rgb(var(--accent))]">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  class={fieldClass}
                  placeholder="Your name"
                />
              </div>
              <div class="space-y-2">
                <label
                  class="block text-sm font-medium text-[rgb(var(--text-primary))]"
                  for="email"
                >
                  Email <span class="text-[rgb(var(--accent))]">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class={fieldClass}
                  placeholder="your.email@example.com"
                />
              </div>
            </div>

            <div class="space-y-2">
              <label
                class="block text-sm font-medium text-[rgb(var(--text-primary))]"
                for="subject"
              >
                Subject <span class="text-[rgb(var(--accent))]">*</span>
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                class={fieldClass}
                placeholder="What's this about?"
              />
            </div>

            <div class="space-y-2">
              <label
                class="block text-sm font-medium text-[rgb(var(--text-primary))]"
                for="message"
              >
                Message <span class="text-[rgb(var(--accent))]">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="7"
                required
                class={`${fieldClass} resize-y`}
                placeholder="A little about you and what you have in mind"
                aria-describedby="message-help"></textarea>
              <p id="message-help" class="meta text-xs">
                The more context you give, the faster Harry can point you to the
                right venture.
              </p>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-full group">
              Send message
              <svg
                class="h-5 w-5 transition-transform group-hover:translate-x-1"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"
                ></path>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</AppLayout>

<script>
  // Handle form submission and success message
  const form = document.querySelector('form[name="contact"]');
  const submitButton = form?.querySelector(
    'button[type="submit"]',
  ) as HTMLButtonElement | null;

  if (form && submitButton) {
    form.addEventListener("submit", () => {
      submitButton.innerHTML = `
        <svg class="animate-spin -ml-1 mr-3 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Sending...
      `;
      submitButton.disabled = true;
    });
  }
</script>
