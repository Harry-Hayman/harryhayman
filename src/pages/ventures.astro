---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
import RadialDiagram from "@components/RadialDiagram.astro";
import VentureCard from "@components/VentureCard.astro";
import { ventures } from "../data/ventures";
---

<AppLayout
  title="Ventures and Initiatives | Harry Hayman"
  description="The ventures Harry Hayman leads in Philadelphia: Gemini Hospitality Consultants, Philadelphia Jazz Experience, Veggie Graffiti and Feed Philly Coalition."
  textBubbles={true}
>
  <div class="py-8">
    <div class="container mx-auto">
      <!-- Radial Diagram -->
      <RadialDiagram />

      <!-- Header -->
      <header class="max-w-3xl mx-auto text-center mb-16" data-aos="fade-up">
        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold mb-6 text-[rgb(var(--text-primary))]"
        >
          Ventures & Initiatives
        </h1>
        <p
          class="text-lg sm:text-xl text-[rgb(var(--text-secondary))] leading-relaxed"
        >
          Exploring innovative solutions across hospitality, culture, and
          community development.
        </p>
      </header>

      <!-- Ventures Grid -->
      <div class="grid gap-8 md:grid-cols-2">
        {
          ventures.map((venture, index) => (
            <VentureCard
              {...venture}
              data-aos="fade-up"
              data-aos-delay={(index % 2) * 100}
            />
          ))
        }
      </div>

      <!-- Call to Action -->
      <div class="text-center mt-16">
        <h2
          class="text-2xl sm:text-3xl font-serif font-bold mb-4 text-[rgb(var(--text-primary))]"
        >
          Get Involved
        </h2>
        <p class="text-[rgb(var(--text-secondary))] mb-8 max-w-2xl mx-auto">
          Interested in collaborating or learning more about our initiatives?
          Let's connect and explore opportunities together.
        </p>
        <a href="/contact" class="btn btn-primary"> Get in touch with Harry </a>
      </div>
    </div>
  </div>
</AppLayout>
