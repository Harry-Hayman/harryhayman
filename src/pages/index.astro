---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
import VentureLogos from "@components/VentureLogos.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ventures } from "../data/ventures";
/* Cut-out from the studio shoot, upscaled 2x. A cool black and white grade of
   the same cut-out sits beside it (harry-hayman-portrait-bw.webp) if the hero
   should ever match the monochrome reference exactly: swap this import. */
import portrait from "../assets/data/harryhayman images/harry-hayman-portrait-color.webp";
import skylineImage from "../assets/data/homepage_images/looking_at_philadelphia_skyline.jpg";

const posts = (await getCollection("blog")).filter((post) => !post.data.draft);

const recentPosts = [...posts]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

/*
 * Hero figures. Each one is counted at build time or already stated on this
 * site, never typed in: the ventures list, the blog collection (rounded down
 * to the last fifty so the "+" stays true as posts are added), and Harry's
 * first job on the about page timeline.
 */
const storyCount =
  posts.length >= 50
    ? `${Math.floor(posts.length / 50) * 50}+`
    : String(posts.length);

const stats = [
  { value: String(ventures.length), label: "Ventures founded or led" },
  { value: storyCount, label: "Stories on the blog" },
  { value: "17", label: "Age he started, washing dishes" },
];

/*
 * The six threads that run through Harry's work. These replace the six
 * illustrated cards that used to sit here: the artwork was generated against
 * the old purple brand and one of the images carried a stock watermark, so
 * the section is now built entirely from the brand's own type and rules.
 */
const pillars = [
  {
    title: "Jazz and music",
    description:
      "Harry's love for jazz blossomed during his early career as a bartender in a jazz club. That passion led him to establish the Philadelphia Jazz Experience, preserving the city's rich jazz heritage.",
  },
  {
    title: "Hospitality innovation",
    description:
      "A pioneer in Philadelphia's hospitality scene, Harry has worked to transform the industry through ventures including the Bynum Hospitality Group and Gemini Hospitality Consultants.",
  },
  {
    title: "Community service",
    description:
      "Through initiatives like the Feed Philly Coalition, Harry's commitment to community service extends beyond food security to the arts, education and local development.",
  },
  {
    title: "Creative work",
    description:
      "Harry's creative spirit drives new initiatives while promoting artistic expression, published through Harry Hayman Creative and @harryhaymancreative.",
  },
  {
    title: "Storytelling through film",
    description:
      "Through Another Three Hearts Experience, Harry turns imaginative concepts into narratives, contributing to Philadelphia's arts and entertainment scene.",
  },
  {
    title: "Environmental innovation",
    description:
      "Through Veggie Graffiti and controlled environmental agriculture, Harry works on urban farming and food security for a more sustainable Philadelphia.",
  },
];

const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<AppLayout
  title="Harry Hayman | Philadelphia Hospitality, Jazz & Community"
  description="Meet Harry Hayman, the Philadelphia hospitality entrepreneur behind Gemini Hospitality Consultants, Feed Philly Coalition and the Philadelphia Jazz Experience."
  footerVentures={false}
>
  <!-- ============================================================ -->
  <!-- Hero: one soft card. Harry steps out of its top edge, the    -->
  <!-- way into working with him rests on glass over the portrait,  -->
  <!-- and the ventures he built run underneath.                    -->
  <!-- ============================================================ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="wrap">
      <div class="hero-card">
        <div class="hero-copy">
          <h1 id="hero-heading" class="hero-title">
            <span class="block">Harry Hayman</span>
            <span class="hero-title-soft block">of Philadelphia</span>
          </h1>
          <p class="hero-lede">
            Hospitality entrepreneur, jazz advocate and philanthropist. CEO of
            Gemini Hospitality Consultants and a Senior Fellow at The Economy
            League of Greater Philadelphia.
          </p>
          <div class="hero-actions">
            <a href="/ventures" class="btn btn-primary">
              Explore Harry's ventures
            </a>
            <a href="/about" class="btn btn-secondary">Read Harry's story</a>
          </div>
          <dl class="hero-stats">
            {
              stats.map((stat) => (
                <div class="hero-stat">
                  <dt>{stat.label}</dt>
                  <dd>{stat.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="hero-visual">
          <Image
            src={portrait}
            alt="Harry Hayman, smiling with his arms crossed, in a plaid blazer"
            class="hero-portrait"
            widths={[360, 480, 640, 800, 1000, 1261]}
            sizes="(min-width: 1160px) 640px, (min-width: 640px) 490px, 118vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <a href="/contact" class="hero-glass">
            <span class="hero-glass-text">
              <span class="hero-glass-kicker">Work with Harry</span>
              <span class="hero-glass-title">
                Consulting, talks and partnerships
              </span>
              <span class="hero-glass-body">
                Email or call about consulting, speaking or the initiatives.
              </span>
            </span>
            <span class="hero-glass-arrow" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 17 17 7M8.5 7H17v8.5"></path>
              </svg>
            </span>
          </a>
        </div>
      </div>

      <div class="hero-ventures">
        <VentureLogos variant="marquee" />
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Proof: the ventures, as an editorial index                   -->
  <!-- ============================================================ -->
  <section class="wrap section" aria-labelledby="ventures-heading">
    <div class="section-head">
      <div>
        <p class="kicker">The work</p>
        <h2 id="ventures-heading" class="heading-2 mt-3">
          Eight ventures, one city
        </h2>
      </div>
      <a href="/ventures" class="link-more">
        See every venture
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"
          ></path>
        </svg>
      </a>
    </div>

    <ol class="grid sm:grid-cols-2 sm:gap-x-10">
      {
        ventures.map((venture, index) => (
          <li>
            <a
              href="/ventures"
              class="index-row group h-full items-baseline rounded-field px-2 -mx-2"
              data-aos="fade-up"
              data-aos-delay={(index % 2) * 60}
            >
              <span class="index-num pt-0.5">{pad(index)}</span>
              <span class="flex items-start justify-between gap-3">
                <span class="min-w-0">
                  <span class="block heading-3 text-[rgb(var(--text-primary))] transition-colors group-hover:text-[rgb(var(--accent))]">
                    {venture.title}
                  </span>
                  <span class="mt-1 block text-sm text-[rgb(var(--text-muted))]">
                    {venture.sector}
                  </span>
                </span>
                <svg
                  class="mt-1.5 h-4 w-4 shrink-0 text-[rgb(var(--accent))] opacity-0 transition-all duration-200 ease-editorial group-hover:translate-x-1 group-hover:opacity-100"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ============================================================ -->
  <!-- Why: the threads running through the work                    -->
  <!-- ============================================================ -->
  <section
    class="border-y border-[rgb(var(--nav-border))] bg-[rgb(var(--surface-sunken))]"
    aria-labelledby="pillars-heading"
  >
    <div class="wrap section">
      <div class="section-head">
        <div>
          <p class="kicker">What drives it</p>
          <h2 id="pillars-heading" class="heading-2 mt-3">
            Six threads through the work
          </h2>
        </div>
      </div>

      <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          pillars.map((pillar, index) => (
            <li
              class="panel h-full rounded-card p-6 sm:p-7"
              data-aos="fade-up"
              data-aos-delay={(index % 3) * 70}
            >
              <p class="index-num">{pad(index)}</p>
              <h3 class="heading-3 mt-3 text-[rgb(var(--text-primary))]">
                {pillar.title}
              </h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-[rgb(var(--text-secondary))]">
                {pillar.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Philadelphia                                                 -->
  <!-- ============================================================ -->
  <section class="wrap section" aria-labelledby="city-heading">
    <div class="relative overflow-hidden rounded-panel">
      <div class="duotone relative h-[18rem] w-full sm:h-[24rem] md:h-[28rem]">
        <Image
          src={skylineImage}
          alt="The Philadelphia skyline at dusk"
          class="h-full w-full object-cover object-center"
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1152px) 100vw, 1152px"
          format="webp"
          quality={62}
          loading="lazy"
          decoding="async"
        />
      </div>
      <!-- The ramp is the type's reading surface, not decoration: measured
           against the brightest sky pixel behind the kicker, the previous
           /90 to /55 ramp left it at 4.09:1. This holds it above AA. -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-brand-950/95 via-brand-950/72 to-brand-900/25"
        aria-hidden="true"
      >
      </div>
      <div class="absolute inset-0 flex items-end">
        <div class="p-6 sm:p-10 md:p-14">
          <p class="kicker text-brand-100">The city</p>
          <h2
            id="city-heading"
            class="heading-2 mt-4 max-w-[18ch] text-white drop-shadow-sm"
          >
            Shaping Philadelphia's future, one step at a time.
          </h2>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Latest writing                                               -->
  <!-- ============================================================ -->
  {
    recentPosts.length > 0 && (
      <section class="wrap pb-4" aria-labelledby="writing-heading">
        <div class="section-head">
          <div>
            <p class="kicker">From the blog</p>
            <h2 id="writing-heading" class="heading-2 mt-3">
              Latest writing
            </h2>
          </div>
          <a href="/blog" class="link-more">
            Browse all of Harry's writing
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
        </div>

        <ul class="grid gap-6 md:grid-cols-3">
          {recentPosts.map((post, index) => (
            <li
              class="card card-link h-full"
              data-aos="fade-up"
              data-aos-delay={index * 70}
            >
              <a href={`/blog/${post.slug}`} class="flex h-full flex-col p-6">
                <p class="meta text-xs uppercase tracking-[0.14em]">
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </p>
                <h3 class="heading-3 mt-3 text-[rgb(var(--text-primary))]">
                  {post.data.title}
                </h3>
                <p class="clamp-3 mt-3 text-sm leading-relaxed text-[rgb(var(--text-secondary))]">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- ============================================================ -->
  <!-- Call to action                                               -->
  <!-- ============================================================ -->
  <section class="wrap section" aria-labelledby="cta-heading">
    <div class="panel-ink px-6 py-12 sm:px-12 sm:py-16">
      <div class="mx-auto max-w-2xl text-center">
        <p class="kicker justify-center">Get involved</p>
        <h2 id="cta-heading" class="heading-2 mt-4 text-white">
          Join the movement
        </h2>
        <p class="mt-4 text-[rgb(var(--ink-panel-muted))] sm:text-lg">
          Whether you care about the arts, sustainability or community
          development, there is a place for you in these initiatives.
        </p>
        <div
          class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
        >
          <a href="/contact" class="btn btn-on-ink btn-lg">
            Get in touch with Harry
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"
              ></path>
            </svg>
          </a>
          <a href="/blog" class="btn btn-ghost-on-ink btn-lg">
            Read Harry's stories
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /*
     * Hero. The card is one soft surface; the portrait is a cut-out that
     * stands on the card's floor and rises through its top edge, so the card
     * cannot clip it. The visual column clips only its bottom-right corner,
     * to the card's own radius, and lets everything above the card through.
     */
    .hero {
      --breakout: clamp(2.25rem, 4.5vw, 3.75rem);
      padding-top: calc(var(--breakout) + clamp(1rem, 2.5vw, 2rem));
      /* clip-path hides the cut-out where it crosses the card's sides, but
         its box would still widen the page. clip, unlike hidden, leaves the
         vertical axis free for the head rising above the card. */
      overflow-x: clip;
    }

    .hero-card {
      position: relative;
      isolation: isolate;
      display: grid;
      border-radius: var(--r-2xl);
      background: linear-gradient(
        100deg,
        rgb(var(--hero-from)) 0%,
        rgb(var(--hero-from)) 42%,
        rgb(var(--hero-to)) 100%
      );
    }

    .hero-copy {
      position: relative;
      z-index: 2;
      padding: clamp(1.75rem, 4.5vw, 3rem);
      padding-bottom: clamp(1.5rem, 4vw, 3rem);
    }

    .hero-title {
      font-family: "Playfair Display", Georgia, serif;
      font-weight: 700;
      font-size: clamp(2.5rem, 1.6rem + 3vw, 3.875rem);
      line-height: 1.04;
      letter-spacing: -0.022em;
      color: rgb(var(--text-primary));
    }

    .hero-title-soft {
      color: rgb(var(--display-soft));
    }

    .hero-lede {
      margin-top: clamp(1rem, 2vw, 1.375rem);
      max-width: 46ch;
      font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
      line-height: 1.65;
      color: rgb(var(--text-secondary));
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: clamp(1.5rem, 2.5vw, 1.75rem);
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, max-content));
      gap: clamp(1.25rem, 3vw, 2.25rem);
      margin-top: clamp(1.75rem, 3.5vw, 2.25rem);
    }

    /* Figure above its label, with dt kept first in the source. Packed to
       the top so the figures share one line however the labels wrap. */
    .hero-stat {
      display: flex;
      flex-direction: column-reverse;
      justify-content: flex-end;
      gap: 0.375rem;
    }

    .hero-stat dd {
      margin: 0;
      font-family: "Playfair Display", Georgia, serif;
      font-weight: 700;
      font-size: clamp(1.75rem, 1.45rem + 1.1vw, 2.375rem);
      line-height: 1;
      letter-spacing: -0.02em;
      font-variant-numeric: lining-nums;
      color: rgb(var(--text-primary));
    }

    .hero-stat dt {
      max-width: 8.25em;
      font-size: 0.875rem;
      line-height: 1.4;
      color: rgb(var(--text-muted));
    }

    /* ---------------------------------------------------------------- */
    /* Portrait and glass                                                */
    /* ---------------------------------------------------------------- */

    .hero-visual {
      position: relative;
      z-index: 1;
      min-height: clamp(22rem, 108vw, 28rem);
      /* Open above the card, closed at its sides and floor, rounded at the
         two lower corners the stacked layout shares with the card. */
      clip-path: inset(-20rem 0 0 0 round 0 0 var(--r-2xl) var(--r-2xl));
    }

    .hero-portrait {
      position: absolute;
      bottom: 0;
      left: 50%;
      height: 100%;
      width: auto;
      max-width: none;
      transform: translateX(-50%);
      /* A cut-out needs a floor shadow, not a box shadow. */
      filter: drop-shadow(0 18px 30px rgba(var(--brand-950), 0.18));
    }

    .hero-glass {
      position: absolute;
      left: clamp(0.75rem, 3vw, 1.5rem);
      right: clamp(0.75rem, 3vw, 1.5rem);
      bottom: clamp(0.75rem, 3vw, 1.5rem);
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.125rem 1.125rem 1.125rem 1.375rem;
      border-radius: var(--r-lg);
      border: 1px solid rgba(255, 255, 255, 0.22);
      /* Dense enough that white text keeps 4.5:1 even over the beard. */
      background-color: rgba(var(--glass-tint), 0.6);
      -webkit-backdrop-filter: blur(18px) saturate(140%);
      backdrop-filter: blur(18px) saturate(140%);
      box-shadow: 0 18px 40px -24px rgba(var(--brand-950), 0.7);
      color: #fff;
      transition:
        background-color var(--dur-1) var(--ease),
        transform var(--dur-1) var(--ease);
    }

    .hero-glass:hover {
      background-color: rgba(var(--glass-tint), 0.7);
    }

    .hero-glass:hover .hero-glass-arrow {
      transform: translate(2px, -2px);
    }

    .hero-glass:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 3px;
    }

    .hero-glass-text {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      gap: 0.25rem;
      min-width: 0;
    }

    .hero-glass-kicker {
      font-size: 0.8125rem;
      color: rgba(255, 255, 255, 0.86);
    }

    .hero-glass-title {
      font-size: 1.0625rem;
      font-weight: 600;
      line-height: 1.3;
    }

    .hero-glass-body {
      font-size: 0.875rem;
      line-height: 1.5;
      color: rgba(255, 255, 255, 0.86);
    }

    .hero-glass-arrow {
      display: inline-flex;
      flex: none;
      align-items: center;
      justify-content: center;
      width: 3rem;
      height: 3rem;
      border-radius: var(--r-md);
      background-color: #fff;
      color: rgb(var(--brand-950));
      box-shadow: 0 6px 14px -8px rgba(0, 0, 0, 0.5);
      transition: transform var(--dur-1) var(--ease);
    }

    .hero-glass-arrow svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    /* Two columns once the copy and the portrait both have room. Below this
       the portrait would have to shrink inside its card to keep clear of the
       figures, and the head would stop rising through the top edge, so the
       card stacks instead. */
    @media (min-width: 1160px) {
      .hero-card {
        grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
        min-height: 30rem;
      }

      .hero-copy {
        padding-right: 0;
        align-self: center;
      }

      .hero-visual {
        min-height: 0;
        clip-path: inset(-20rem 0 0 -16rem round 0 0 var(--r-2xl) 0);
      }

      /* Stands on the card's floor and rises through its top edge. The
         card's right edge crops the far elbow, as in a portrait plate. */
      .hero-portrait {
        left: auto;
        right: -13%;
        height: calc(100% + var(--breakout));
        transform: none;
      }

      .hero-glass {
        left: auto;
        right: clamp(1.5rem, 3vw, 2.5rem);
        bottom: clamp(1.5rem, 3vw, 2.5rem);
        width: min(21rem, 78%);
      }
    }

    /* Stacked, with room to spare: portrait to the right, glass to the left. */
    @media (min-width: 640px) and (max-width: 1159px) {
      .hero-portrait {
        left: auto;
        right: 6%;
        transform: none;
      }

      .hero-glass {
        right: auto;
        width: min(22rem, 52%);
      }
    }

    .hero-ventures {
      margin-top: clamp(1.75rem, 4vw, 2.75rem);
    }

    @media (max-width: 479px) {
      .hero-stats {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .hero-stat dt {
        font-size: 0.75rem;
      }

      .hero-actions .btn {
        flex: 1 1 100%;
      }
    }
  </style>
</AppLayout>
