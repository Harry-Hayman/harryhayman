---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
import Bubbles from "@components/Bubbles.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ventures } from "../data/ventures";
import authorImage from "../assets/data/harryhayman images/harryhayman_bg_removed.png";
import skylineImage from "../assets/data/homepage_images/looking_at_philadelphia_skyline.jpg";

const recentPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

/* Roles and organisations, all of them already stated on the about page. */
const credentials = [
  {
    role: "CEO",
    org: "Gemini Hospitality Consultants",
  },
  {
    role: "Senior Fellow",
    org: "The Economy League of Greater Philadelphia",
  },
  {
    role: "Founder",
    org: "Six Philadelphia ventures and initiatives",
  },
];

/*
 * The six threads that run through Harry's work. These replace the six
 * illustrated cards that used to sit here: the artwork was generated against
 * the old purple brand and one of the images carried a stock watermark, so
 * the section is now built entirely from the brand's own type and rules.
 */
const pillars = [
  {
    title: "Jazz and music",
    description:
      "Harry's love for jazz blossomed during his early career as a bartender in a jazz club. That passion led him to establish the Philadelphia Jazz Experience, preserving the city's rich jazz heritage.",
  },
  {
    title: "Hospitality innovation",
    description:
      "A pioneer in Philadelphia's hospitality scene, Harry has worked to transform the industry through ventures including the Bynum Hospitality Group and Gemini Hospitality Consultants.",
  },
  {
    title: "Community service",
    description:
      "Through initiatives like the Feed Philly Coalition, Harry's commitment to community service extends beyond food security to the arts, education and local development.",
  },
  {
    title: "Creative work",
    description:
      "Harry's creative spirit drives new initiatives while promoting artistic expression, published through Harry Hayman Creative and @harryhaymancreative.",
  },
  {
    title: "Storytelling through film",
    description:
      "Through Another Three Hearts Experience, Harry turns imaginative concepts into narratives, contributing to Philadelphia's arts and entertainment scene.",
  },
  {
    title: "Environmental innovation",
    description:
      "Through Veggie Graffiti and controlled environmental agriculture, Harry works on urban farming and food security for a more sustainable Philadelphia.",
  },
];

const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<AppLayout
  title="Harry Hayman | Philadelphia Hospitality, Jazz & Community"
  description="Meet Harry Hayman, the Philadelphia hospitality entrepreneur behind Gemini Hospitality Consultants, Feed Philly Coalition and the Philadelphia Jazz Experience."
>
  <!-- ============================================================ -->
  <!-- Hero: who Harry is, in one screen                            -->
  <!-- The floating field lives here and only here: the band clips  -->
  <!-- it, so it never runs on down the page or onto another page.  -->
  <!-- ============================================================ -->
  <div class="hero-band">
    <Bubbles />
    <section
      class="wrap relative z-10 pt-10 pb-12 sm:pt-16 sm:pb-16"
      aria-labelledby="hero-heading"
    >
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <p class="kicker">Philadelphia, Pennsylvania</p>
        <h1 id="hero-heading" class="display-1 mt-5">
          Harry <span class="italic text-[rgb(var(--accent))]">Hayman</span>
        </h1>
        <p class="lede mt-6 max-w-[46ch]">
          Hospitality entrepreneur, jazz advocate and philanthropist, working
          across Philadelphia's restaurants, music rooms and community kitchens.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/ventures" class="btn btn-primary btn-lg">
            Explore Harry's ventures
          </a>
          <a href="/about" class="btn btn-secondary btn-lg">
            Read Harry's story
          </a>
        </div>
      </div>

      <!-- Portrait: a designed plate, not a floating blob -->
      <div class="lg:col-span-5">
        <figure class="portrait-frame">
          <div class="portrait-plate">
            <span class="portrait-mark" aria-hidden="true">HH</span>
            <Image
              src={authorImage}
              alt="Harry Hayman"
              class="portrait-img"
              width={501}
              height={597}
              format="webp"
              quality={80}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              sizes="(max-width: 640px) 68vw, 350px"
            />
          </div>
          <figcaption class="portrait-caption">
            Harrison Graham Hayman IV
          </figcaption>
        </figure>
      </div>
    </div>

    <!-- Credibility strip -->
    <dl
      class="panel mt-12 grid divide-y divide-[rgb(var(--nav-border))] sm:mt-16 sm:grid-cols-3 sm:divide-x sm:divide-y-0"
    >
      {
        credentials.map((item) => (
          <div class="px-5 py-5 sm:px-6 sm:py-6">
            <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-[rgb(var(--accent))]">
              {item.role}
            </dt>
            <dd class="mt-2 text-[0.9375rem] font-medium leading-snug text-[rgb(var(--text-primary))]">
              {item.org}
            </dd>
          </div>
        ))
      }
    </dl>
    </section>
  </div>

  <!-- ============================================================ -->
  <!-- Proof: the ventures, as an editorial index                   -->
  <!-- ============================================================ -->
  <section class="wrap section" aria-labelledby="ventures-heading">
    <div class="section-head">
      <div>
        <p class="kicker">The work</p>
        <h2 id="ventures-heading" class="heading-2 mt-3">
          Eight ventures, one city
        </h2>
      </div>
      <a href="/ventures" class="link-more">
        See every venture
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"
          ></path>
        </svg>
      </a>
    </div>

    <ol class="grid sm:grid-cols-2 sm:gap-x-10">
      {
        ventures.map((venture, index) => (
          <li>
            <a
              href="/ventures"
              class="index-row group h-full items-baseline rounded-field px-2 -mx-2"
              data-aos="fade-up"
              data-aos-delay={(index % 2) * 60}
            >
              <span class="index-num pt-0.5">{pad(index)}</span>
              <span class="flex items-start justify-between gap-3">
                <span class="min-w-0">
                  <span class="block heading-3 text-[rgb(var(--text-primary))] transition-colors group-hover:text-[rgb(var(--accent))]">
                    {venture.title}
                  </span>
                  <span class="mt-1 block text-sm text-[rgb(var(--text-muted))]">
                    {venture.sector}
                  </span>
                </span>
                <svg
                  class="mt-1.5 h-4 w-4 shrink-0 text-[rgb(var(--accent))] opacity-0 transition-all duration-200 ease-editorial group-hover:translate-x-1 group-hover:opacity-100"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ============================================================ -->
  <!-- Why: the threads running through the work                    -->
  <!-- ============================================================ -->
  <section
    class="border-y border-[rgb(var(--nav-border))] bg-[rgb(var(--surface-sunken))]"
    aria-labelledby="pillars-heading"
  >
    <div class="wrap section">
      <div class="section-head">
        <div>
          <p class="kicker">What drives it</p>
          <h2 id="pillars-heading" class="heading-2 mt-3">
            Six threads through the work
          </h2>
        </div>
      </div>

      <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          pillars.map((pillar, index) => (
            <li
              class="panel h-full rounded-card p-6 sm:p-7"
              data-aos="fade-up"
              data-aos-delay={(index % 3) * 70}
            >
              <p class="index-num">{pad(index)}</p>
              <h3 class="heading-3 mt-3 text-[rgb(var(--text-primary))]">
                {pillar.title}
              </h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-[rgb(var(--text-secondary))]">
                {pillar.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Philadelphia                                                 -->
  <!-- ============================================================ -->
  <section class="wrap section" aria-labelledby="city-heading">
    <div class="relative overflow-hidden rounded-panel">
      <div class="duotone relative h-[18rem] w-full sm:h-[24rem] md:h-[28rem]">
        <Image
          src={skylineImage}
          alt="The Philadelphia skyline at dusk"
          class="h-full w-full object-cover object-center"
          width={1408}
          height={768}
          format="webp"
          quality={62}
          loading="lazy"
          decoding="async"
          sizes="(max-width: 768px) 100vw, 1152px"
        />
      </div>
      <!-- The ramp is the type's reading surface, not decoration: measured
           against the brightest sky pixel behind the kicker, the previous
           /90 to /55 ramp left it at 4.09:1. This holds it above AA. -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-brand-950/95 via-brand-950/72 to-brand-900/25"
        aria-hidden="true"
      >
      </div>
      <div class="absolute inset-0 flex items-end">
        <div class="p-6 sm:p-10 md:p-14">
          <p class="kicker text-brand-100">The city</p>
          <h2
            id="city-heading"
            class="heading-2 mt-4 max-w-[18ch] text-white drop-shadow-sm"
          >
            Shaping Philadelphia's future, one step at a time.
          </h2>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- Latest writing                                               -->
  <!-- ============================================================ -->
  {
    recentPosts.length > 0 && (
      <section class="wrap pb-4" aria-labelledby="writing-heading">
        <div class="section-head">
          <div>
            <p class="kicker">From the blog</p>
            <h2 id="writing-heading" class="heading-2 mt-3">
              Latest writing
            </h2>
          </div>
          <a href="/blog" class="link-more">
            Browse all of Harry's writing
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
        </div>

        <ul class="grid gap-6 md:grid-cols-3">
          {recentPosts.map((post, index) => (
            <li
              class="card card-link h-full"
              data-aos="fade-up"
              data-aos-delay={index * 70}
            >
              <a href={`/blog/${post.slug}`} class="flex h-full flex-col p-6">
                <p class="meta text-xs uppercase tracking-[0.14em]">
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </p>
                <h3 class="heading-3 mt-3 text-[rgb(var(--text-primary))]">
                  {post.data.title}
                </h3>
                <p class="clamp-3 mt-3 text-sm leading-relaxed text-[rgb(var(--text-secondary))]">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- ============================================================ -->
  <!-- Call to action                                               -->
  <!-- ============================================================ -->
  <section class="wrap section" aria-labelledby="cta-heading">
    <div class="panel-ink px-6 py-12 sm:px-12 sm:py-16">
      <div class="mx-auto max-w-2xl text-center">
        <p class="kicker kicker-plain justify-center">Get involved</p>
        <h2 id="cta-heading" class="heading-2 mt-4 text-white">
          Join the movement
        </h2>
        <p class="mt-4 text-[rgb(var(--ink-panel-muted))] sm:text-lg">
          Whether you care about the arts, sustainability or community
          development, there is a place for you in these initiatives.
        </p>
        <div
          class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
        >
          <a href="/contact" class="btn btn-on-ink btn-lg">
            Get in touch with Harry
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"
              ></path>
            </svg>
          </a>
          <a href="/blog" class="btn btn-ghost-on-ink btn-lg">
            Read Harry's stories
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /*
     * The hero portrait sits on a ruled brand plate with a hairline and a
     * monogram, and the caption straddles the bottom edge. No masks, no blobs.
     */
    .portrait-frame {
      position: relative;
      width: 100%;
      max-width: 17rem;
      margin: 0 auto;
      padding-bottom: 1.25rem;
    }

    @media (min-width: 640px) {
      .portrait-frame {
        max-width: 21rem;
      }
    }

    @media (min-width: 1024px) {
      /* Anchored to the right edge of its column so the hero has a hard
         outer margin instead of drifting in the middle of the grid. */
      .portrait-frame {
        margin-right: 0;
      }
    }

    .portrait-plate {
      position: relative;
      aspect-ratio: 4 / 5;
      border-radius: var(--r-xl);
      border: 1px solid rgb(var(--nav-border));
      background: linear-gradient(
        165deg,
        rgb(var(--brand-100)) 0%,
        rgb(var(--brand-200)) 100%
      );
      overflow: hidden;
      box-shadow: var(--shadow-2);
    }

    .portrait-plate::after {
      /* A quiet ruled ground so the plate is not a flat swatch. */
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image: repeating-linear-gradient(
        to bottom,
        rgba(var(--brand-700), 0.07) 0 1px,
        transparent 1px 22px
      );
    }

    :global(:root.dark) .portrait-plate {
      background: linear-gradient(
        165deg,
        rgb(var(--brand-900)) 0%,
        rgb(var(--brand-950)) 100%
      );
    }

    :global(:root.dark) .portrait-plate::after {
      background-image: repeating-linear-gradient(
        to bottom,
        rgba(var(--brand-300), 0.09) 0 1px,
        transparent 1px 22px
      );
    }

    .portrait-mark {
      position: absolute;
      top: 1rem;
      left: 1.25rem;
      z-index: 1;
      font-family: 'Playfair Display', Georgia, serif;
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: 0.06em;
      color: rgba(var(--brand-700), 0.55);
    }

    :global(:root.dark) .portrait-mark {
      color: rgba(var(--brand-200), 0.55);
    }

    .portrait-img {
      position: absolute;
      left: 50%;
      bottom: -1px;
      z-index: 2;
      width: 92%;
      height: auto;
      transform: translateX(-50%);
      filter: drop-shadow(0 16px 26px rgba(var(--brand-950), 0.3));
    }

    .portrait-caption {
      position: absolute;
      left: 1.25rem;
      bottom: 0;
      z-index: 3;
      padding: 0.4375rem 0.875rem;
      border-radius: var(--r-xs);
      background-color: rgb(var(--card-bg));
      border: 1px solid rgb(var(--nav-border));
      box-shadow: var(--shadow-1);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgb(var(--text-secondary));
      white-space: nowrap;
    }

    @media (max-width: 400px) {
      .portrait-caption {
        left: 0.75rem;
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
      }
    }
  </style>
</AppLayout>
