---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
import { Image } from "astro:assets";
import aboutImage from "../assets/data/harryhayman images/harry-hayman-hands-folding.jpg";

/*
 * Every fact below already existed on this page. The change is structural:
 * the career is a timeline instead of four boxes of identical bullets, and
 * the boards, talks and values sit in one card system rather than three.
 */
const timeline = [
  {
    era: "90s",
    title: "Early beginnings",
    items: [
      "Attended Radnor High School",
      "Started as a dishwasher in Washington, DC at age 17",
      "Founded Presto! Design at age 19",
      "Graduated from The American University with a B.A. in International Business and Finance",
      "Accepted into Wharton School of Business",
    ],
  },
  {
    era: "00s",
    title: "Business growth",
    items: [
      "Founded The Capital Management & Development Corporation",
      "Established Road Show Management",
      "Launched East Coast Saloons",
      "Joined Bynum Hospitality Group",
      "Operated McFadden's and SOUTH Jazz Club",
    ],
  },
  {
    era: "Now",
    title: "Current ventures",
    items: [
      "CEO of Gemini Hospitality Consultants",
      "Founded Harry Hayman Creative",
      "Created Another Three Hearts Experience",
      "Launched Veggie Graffiti",
    ],
  },
];

const beyond = [
  {
    title: "Community impact",
    items: [
      "Founded Feed Philly Coalition",
      "Established The Philadelphia Jazz Experience",
      "Initiated I Am Hungry in Philly",
      "Sr. Fellow at The Economy League of Greater Philadelphia",
    ],
  },
  {
    title: "Educational institutions",
    items: [
      "Temple University, Food and Beverage Management",
      "Drexel University, Food Upcycling Conference",
      "Community College of Philadelphia, Workplace Diversity",
    ],
  },
  {
    title: "Boards and organisations",
    items: [
      "North Broad Street Renaissance Advisory Board",
      "Alex's Lemonade Stand, Board Member",
      "Various Philadelphia community organizations",
    ],
  },
];

const personal = [
  {
    title: "Family background",
    items: [
      "Born in Washington DC to Robin and Harry III",
      "Global upbringing due to his father's banking career",
      "Close relationship with his sister Kimberly",
      "Established the Hayman Family Fund in memory of his brother Brad",
    ],
  },
  {
    title: "Core values",
    items: [
      "Strong family bonds",
      "Community service dedication",
      "Entrepreneurial spirit",
      "Cultural preservation",
      "Innovation in hospitality",
    ],
  },
];
---

<AppLayout
  title="About Harry Hayman | Philadelphia Hospitality Leader"
  description="Who is Harry Hayman? From dishwasher at 17 to CEO of Gemini Hospitality Consultants: the Philadelphia hospitality leader's career, ventures and community work."
>
  <!-- Header -->
  <section class="wrap pt-12 sm:pt-16">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="kicker">About</p>
        <h1 class="display-2 mt-5">About Harry Hayman</h1>
      </div>
      <div class="lg:col-span-5">
        <p class="lede">
          A dynamic leader and influential figure in Philadelphia's restaurant
          and hospitality industries, with an entrepreneurial spirit that has
          fueled numerous successful ventures.
        </p>
      </div>
    </div>
    <hr class="rule mt-10" />
  </section>

  <!-- Direct answer for people and answer engines asking "who is he?" -->
  <section class="wrap section-tight" aria-labelledby="who-is-heading">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <div class="panel h-full p-6 sm:p-8">
          <p class="kicker">In short</p>
          <h2 id="who-is-heading" class="heading-2 mt-4">
            Who is Harry Hayman?
          </h2>
          <p
            class="mt-5 text-base leading-relaxed text-[rgb(var(--text-primary))] sm:text-lg"
          >
            Harry Hayman, in full Harrison Graham Hayman IV, is a Philadelphia
            hospitality entrepreneur, jazz advocate and philanthropist. He is
            CEO of Gemini Hospitality Consultants and a Senior Fellow at The
            Economy League of Greater Philadelphia. He founded the Feed Philly
            Coalition, The Philadelphia Jazz Experience, Harry Hayman Creative,
            Veggie Graffiti, Another Three Hearts Experience and I Am Hungry in
            Philly. He started in hospitality at 17 as a dishwasher in
            Washington, DC, and has since operated Philadelphia rooms including
            McFadden's and SOUTH Jazz Club.
          </p>
        </div>
      </div>
      <div class="lg:col-span-5">
        <figure class="h-full">
          <div
            class="h-full overflow-hidden rounded-card border border-[rgb(var(--nav-border))] shadow-2"
          >
            <Image
              src={aboutImage}
              alt="Harry Hayman"
              class="h-64 w-full object-cover object-[center_28%] sm:h-80 lg:h-full lg:min-h-[20rem]"
              width={1000}
              height={667}
              format="webp"
              quality={72}
              loading="lazy"
              decoding="async"
              sizes="(max-width: 1024px) 100vw, 440px"
            />
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- Professional journey -->
  <section
    class="border-y border-[rgb(var(--nav-border))] bg-[rgb(var(--surface-sunken))]"
    aria-labelledby="journey-heading"
  >
    <div class="wrap section">
      <div class="section-head">
        <div>
          <p class="kicker">The route here</p>
          <h2 id="journey-heading" class="heading-2 mt-3">
            Professional journey
          </h2>
        </div>
      </div>

      <ol class="timeline">
        {
          timeline.map((entry) => (
            <li class="timeline-item" data-aos="fade-up">
              <span class="timeline-era">{entry.era}</span>
              <div class="timeline-head">
                <h3 class="heading-3 text-[rgb(var(--text-primary))]">
                  {entry.title}
                </h3>
              </div>
              <ul class="timeline-facts">
                {entry.items.map((item) => (
                  <li class="fact-row">{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Beyond the ventures -->
  <section class="wrap section" aria-labelledby="beyond-heading">
    <div class="section-head">
      <div>
        <p class="kicker">Off the balance sheet</p>
        <h2 id="beyond-heading" class="heading-2 mt-3">Beyond the ventures</h2>
      </div>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {
        beyond.map((block, index) => (
          <div
            class="panel h-full p-6"
            data-aos="fade-up"
            data-aos-delay={index * 70}
          >
            <h3 class="heading-3 text-[rgb(var(--text-primary))]">
              {block.title}
            </h3>
            <ul class="mt-4">
              {block.items.map((item) => (
                <li class="fact-row">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Personal life and values -->
  <section
    class="border-y border-[rgb(var(--nav-border))] bg-[rgb(var(--surface-sunken))]"
    aria-labelledby="personal-heading"
  >
    <div class="wrap section">
      <div class="section-head">
        <div>
          <p class="kicker">Away from work</p>
          <h2 id="personal-heading" class="heading-2 mt-3">
            Personal life and values
          </h2>
        </div>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {
          personal.map((block, index) => (
            <div
              class="panel h-full p-6 sm:p-8"
              data-aos="fade-up"
              data-aos-delay={index * 70}
            >
              <h3 class="heading-3 text-[rgb(var(--text-primary))]">
                {block.title}
              </h3>
              <ul class="mt-4">
                {block.items.map((item) => (
                  <li class="fact-row">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Call to action -->
  <section class="wrap section" aria-labelledby="journey-cta">
    <div class="panel-ink px-6 py-12 sm:px-12 sm:py-16">
      <div class="mx-auto max-w-2xl text-center">
        <p class="kicker justify-center">What is next</p>
        <h2 id="journey-cta" class="heading-2 mt-4 text-white">
          Join the journey
        </h2>
        <p class="mt-4 text-[rgb(var(--ink-panel-muted))] sm:text-lg">
          Connect with Harry Hayman and be part of the initiatives shaping
          Philadelphia's future.
        </p>
        <div
          class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
        >
          <a href="/ventures" class="btn btn-on-ink btn-lg">
            Explore Harry's ventures
          </a>
          <a href="/contact" class="btn btn-ghost-on-ink btn-lg">
            Get in touch with Harry
          </a>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* A single rail with era markers: one story, read top to bottom. */
    .timeline {
      position: relative;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .timeline-item {
      position: relative;
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 0 0 2.5rem 2.25rem;
      border-left: 1px solid rgb(var(--nav-border));
    }

    .timeline-item:last-child {
      padding-bottom: 0;
      border-left-color: transparent;
    }

    .timeline-era {
      position: absolute;
      left: 0;
      top: 0;
      transform: translateX(-50%);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 3rem;
      height: 1.875rem;
      padding: 0 0.625rem;
      border-radius: var(--r-pill);
      background-color: rgb(var(--button-primary));
      color: rgb(var(--button-on));
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .timeline-head {
      padding-top: 0.125rem;
    }

    .timeline-facts {
      margin: 0;
      padding: 0;
      min-width: 0;
    }

    @media (min-width: 768px) {
      .timeline-item {
        grid-template-columns: 16rem minmax(0, 1fr);
        gap: 2.5rem;
        padding-left: 3rem;
        padding-bottom: 3rem;
      }

      .timeline-facts {
        margin-top: 0;
      }
    }

    /* Facts read as ruled rows, not as a bulleted list of equal dots. */
    .fact-row {
      position: relative;
      padding: 0.625rem 0 0.625rem 1.125rem;
      border-top: 1px solid rgb(var(--nav-border));
      font-size: 0.9375rem;
      line-height: 1.55;
      color: rgb(var(--text-secondary));
      list-style: none;
    }

    .fact-row::before {
      content: '';
      position: absolute;
      left: 0;
      top: 1.15rem;
      width: 0.375rem;
      height: 0.375rem;
      border-radius: var(--r-pill);
      background-color: rgb(var(--brand-500));
    }

    .fact-row:last-child {
      padding-bottom: 0;
    }
  </style>
</AppLayout>
