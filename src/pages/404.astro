---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
const title = "Page not found | Harry Hayman";
const description =
  "That page does not exist. Head back to the homepage, or browse Harry Hayman's writing on Philadelphia hospitality, jazz and community.";

const routes = [
  {
    href: "/about",
    label: "About Harry Hayman",
    body: "The career, the ventures and the community work, in order.",
  },
  {
    href: "/ventures",
    label: "Ventures",
    body: "Eight organisations Harry founded or leads in Philadelphia.",
  },
  {
    href: "/blog",
    label: "Blog",
    body: "Restaurants, jazz nights, food security and the people building the city.",
  },
];
---

<AppLayout title={title} description={description}>
  <section class="wrap flex min-h-[62vh] flex-col justify-center py-16">
    <div class="max-w-2xl">
      <p class="kicker">Error 404</p>
      <h1 class="display-2 mt-5">This page does not exist</h1>
      <p class="lede mt-5">
        The link may be out of date. Try the homepage, or pick up one of the
        threads below.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="btn btn-primary btn-lg" href="/">Go to the homepage</a>
        <a class="btn btn-secondary btn-lg" href="/blog">Browse the blog</a>
      </div>
    </div>

    <ul class="mt-14 grid gap-5 md:grid-cols-3">
      {
        routes.map((route) => (
          <li>
            <a
              href={route.href}
              class="panel group flex h-full flex-col p-5 transition-colors hover:border-[rgb(var(--brand-400))] hover:bg-[rgb(var(--accent-soft))]"
            >
              <span class="heading-3 text-[rgb(var(--text-primary))] group-hover:text-[rgb(var(--accent))]">
                {route.label}
              </span>
              <span class="mt-2 text-sm leading-relaxed text-[rgb(var(--text-secondary))]">
                {route.body}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</AppLayout>
