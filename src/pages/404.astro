---
export const prerender = true;

import AppLayout from "@layouts/AppLayout.astro";
const title = "Page not found | Harry Hayman";
const description =
  "That page does not exist. Head back to the homepage, or browse Harry Hayman's writing on Philadelphia hospitality, jazz and community.";
---

<AppLayout title={title} description={description}>
  <div
    class="flex min-h-[60vh] flex-col items-center justify-center px-4 py-16 text-center"
  >
    <p
      class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-[rgb(var(--accent))]"
    >
      Error 404
    </p>
    <h1
      class="mb-4 font-serif text-4xl font-bold text-[rgb(var(--text-primary))] sm:text-5xl"
    >
      This page does not exist
    </h1>
    <p class="mb-8 max-w-xl text-lg text-[rgb(var(--text-secondary))]">
      The link may be out of date. Try the homepage, or browse the blog for
      Harry's writing on Philadelphia hospitality, jazz and community.
    </p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary" href="/">Go to the homepage</a>
      <a class="btn btn-secondary" href="/blog">Browse the blog</a>
    </div>
  </div>
</AppLayout>
