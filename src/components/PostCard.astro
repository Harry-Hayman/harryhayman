---
interface Props {
  title: string;
  description: string;
  image: {
    src: ImageMetadata;
    alt: string;
  };
  index: number;
}

const { title, description, image, index } = Astro.props;

import { Image } from "astro:assets";
---

<div
  data-aos={index % 2 === 0 ? "fade-right" : "fade-left"}
  data-aos-duration="1000"
  class={`group relative overflow-hidden rounded-2xl shadow-lg transition-transform duration-300 hover:-translate-y-2 md:flex ${
    index % 2 === 0 ? "md:flex-row" : "md:flex-row-reverse"
  } bg-[rgb(var(--card-bg))] border border-[rgb(var(--nav-border))]`}
>
  <div class="duotone relative h-64 overflow-hidden md:h-auto md:w-1/2">
    <Image
      src={image.src}
      alt={image.alt}
      class="duotone-image h-full w-full scale-[1.01] object-cover transition-transform duration-500 group-hover:scale-105"
      width={640}
      height={430}
      format="webp"
      quality={62}
      loading="lazy"
      decoding="async"
      sizes="(max-width: 768px) 100vw, 50vw"
    />
    <div class="duotone-tint absolute inset-0" aria-hidden="true"></div>
  </div>
  <div
    class="relative p-6 md:p-8 lg:p-10 md:w-1/2 md:flex md:flex-col md:justify-center"
  >
    <h3
      class="text-xl md:text-2xl font-serif font-bold mb-3 md:mb-4 text-[rgb(var(--text-primary))]"
    >
      {title}
    </h3>
    <p
      class="text-sm md:text-base lg:text-lg font-sans text-[rgb(var(--text-secondary))] md:line-clamp-none"
    >
      {description}
    </p>
  </div>
</div>

<style>
  /*
   * The passion illustrations were commissioned against the old purple brand
   * and read as magenta next to the light-blue system. Rather than replace
   * artwork we do not own, they are rendered as a brand duotone: luminosity
   * from the illustration, hue and saturation from the brand ramp. The result
   * is consistent across all six cards and clearly intentional.
   */
  .duotone {
    isolation: isolate;
  }

  .duotone-image {
    filter: grayscale(1) contrast(1.06) brightness(1.02);
  }

  .duotone-tint {
    background: linear-gradient(
      150deg,
      rgb(var(--brand-900)) 0%,
      rgb(var(--brand-600)) 55%,
      rgb(var(--brand-300)) 100%
    );
    mix-blend-mode: color;
    pointer-events: none;
  }
</style>
