---
/*
 * Ambient music toggle.
 * The vinyl used to be a 4.7 MB PNG from /public rendered at 48 px, which
 * Astro could not optimise. It is now an inline SVG: zero network cost and it
 * follows the theme.
 */
---

<div id="music-player" class="fixed bottom-4 right-4 z-[60]">
  <!-- Track List Drop-up -->
  <div
    id="track-list"
    class="absolute bottom-full right-0 mb-2 w-64 rounded-card border border-[rgb(var(--nav-border))] bg-[rgb(var(--surface-raised))] shadow-2 transform scale-y-0 origin-bottom transition-transform duration-300"
  >
    <div class="p-2 space-y-1 max-h-48 overflow-y-auto">
      <!-- Track items are inserted here by JavaScript -->
    </div>
  </div>

  <!-- Music Toggle Button -->
  <button
    id="music-toggle"
    class="vinyl-record float-control relative overflow-hidden"
    aria-label="Play or pause background music. Double click for the track list."
    title="Play or pause background music"
  >
    <!-- The vinyl is drawn in ink on the same paper control as the theme
         toggle, so the two floating controls read as one pair rather than a
         quiet button next to a heavy dark disc. -->
    <svg
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="12" cy="12" r="10.25" stroke-width="1.5"></circle>
      <circle cx="12" cy="12" r="7" stroke-width="1" stroke-opacity="0.55"
      ></circle>
      <circle cx="12" cy="12" r="4.25" stroke-width="1" stroke-opacity="0.4"
      ></circle>
      <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"
      ></circle>
    </svg>

    <!-- Album art overlay, only filled in once a track is chosen -->
    <div
      id="album-art"
      class="absolute inset-0 rounded-full bg-cover bg-center opacity-0 transition-opacity duration-300"
    >
    </div>
  </button>
</div>

<script>
  import { MusicPlayer } from "../scripts/MusicPlayer";

  let player: MusicPlayer | null = null;
  let isTrackListVisible = false;
  let lastClickTime = 0;
  const doubleClickDelay = 300;

  function createTrackList() {
    if (!player) return;

    const container = document.querySelector("#track-list > div");
    if (!container) return;

    container.innerHTML = "";

    player.getTracks().forEach((track, index) => {
      const item = document.createElement("button");
      item.className =
        "w-full px-3 py-2 text-left rounded transition-colors text-sm text-[rgb(var(--text-primary))] hover:bg-[rgb(var(--accent-soft))] truncate";
      item.textContent = `${track.title} - ${track.artist}`;
      item.onclick = () => {
        player?.playTrack(index);
        hideTrackList();
      };
      container.appendChild(item);
    });
  }

  function toggleTrackList() {
    const trackList = document.getElementById("track-list");
    if (!trackList) return;

    isTrackListVisible = !isTrackListVisible;
    trackList.style.transform = isTrackListVisible ? "scaleY(1)" : "scaleY(0)";

    if (isTrackListVisible) {
      createTrackList();
    }
  }

  function hideTrackList() {
    const trackList = document.getElementById("track-list");
    if (!trackList) return;

    isTrackListVisible = false;
    trackList.style.transform = "scaleY(0)";
  }

  function handleClick(e: MouseEvent) {
    const currentTime = Date.now();
    const timeDiff = currentTime - lastClickTime;

    if (timeDiff < doubleClickDelay) {
      e.preventDefault();
      toggleTrackList();
    } else if (player) {
      player.toggleMusic();
    }

    lastClickTime = currentTime;
  }

  function setupEventListeners() {
    const toggleButton = document.getElementById("music-toggle");
    if (!toggleButton) return;

    toggleButton.addEventListener("click", handleClick);

    document.addEventListener("click", (e) => {
      if (!isTrackListVisible) return;
      const trackList = document.getElementById("track-list");
      const button = document.getElementById("music-toggle");
      if (
        trackList &&
        button &&
        !trackList.contains(e.target as Node) &&
        !button.contains(e.target as Node)
      ) {
        hideTrackList();
      }
    });
  }

  const initComponents = () => {
    if (!player) {
      player = new MusicPlayer();
      setupEventListeners();
    }
  };

  document.addEventListener("astro:page-load", initComponents);
  document.addEventListener("DOMContentLoaded", initComponents);
</script>

<style>
  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .vinyl-record {
    transition: transform 0.3s ease;
  }

  .vinyl-record.spinning svg,
  .vinyl-record.spinning #album-art {
    animation: spin 3s linear infinite;
  }

  /* Album art fills the control once a track is chosen. It used to be
     `mix-blend-mode: overlay` against a dark disc; on the paper control it
     sits inset behind the hairline, under a paper scrim so the ink glyph
     stays legible over any sleeve. */
  #album-art {
    inset: 3px;
    z-index: 0;
  }

  #album-art::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: rgba(var(--surface-raised), 0.58);
  }

  .vinyl-record svg {
    position: relative;
    z-index: 1;
  }

  #track-list {
    backdrop-filter: blur(10px);
  }

  #track-list > div {
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--text-primary), 0.2) transparent;
  }

  #track-list > div::-webkit-scrollbar {
    width: 6px;
  }

  #track-list > div::-webkit-scrollbar-track {
    background: transparent;
  }

  #track-list > div::-webkit-scrollbar-thumb {
    background-color: rgba(var(--text-primary), 0.2);
    border-radius: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .vinyl-record.spinning svg,
    .vinyl-record.spinning #album-art {
      animation: none;
    }
  }
</style>
