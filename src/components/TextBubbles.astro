---
/*
 * Decorative floating keyword bubbles.
 * Rendered from AppLayout so it sits inside <body> (it used to be emitted
 * before <html>, which produced invalid markup). It now stops when the tab is
 * hidden and never starts when the visitor asks for reduced motion.
 */
---

<div
    class="fixed inset-0 overflow-hidden pointer-events-none"
    id="text-bubbles"
    aria-hidden="true"
    style="z-index: 0;"
>
    <template id="template-bubble">
        <div
            class="bubble absolute rounded-full opacity-0 flex items-center justify-center text-center p-4 font-medium"
        >
        </div>
    </template>
</div>

<style>
    .bubble {
        animation-name: float-up;
        animation-iteration-count: infinite;
        animation-timing-function: ease-in-out;
        transition: opacity 0.2s ease-in-out;
        opacity: 0;
        position: absolute;
        bottom: -100px;
        will-change: transform, opacity;
        background-color: rgba(var(--brand-400), 0.14);
        color: rgb(var(--brand-800));
        box-shadow:
            inset 0 0 24px rgba(var(--brand-500), 0.18),
            0 0 0 1px rgba(var(--brand-400), 0.18);
        backdrop-filter: blur(2px);
    }

    :global(:root.dark) .bubble {
        background-color: rgba(var(--brand-400), 0.1);
        color: rgb(var(--brand-200));
        box-shadow:
            inset 0 0 24px rgba(var(--brand-300), 0.14),
            0 0 0 1px rgba(var(--brand-300), 0.16);
    }

    @keyframes float-up {
        0% {
            transform: translateY(0);
            opacity: 0.55;
        }
        95% {
            opacity: 0.55;
            transform: translateY(-120vh);
        }
        100% {
            transform: translateY(-130vh);
            opacity: 0;
        }
    }

    #text-bubbles {
        mask-image: linear-gradient(
            to top,
            transparent,
            black 10% 90%,
            transparent
        );
    }

    @media (prefers-reduced-motion: reduce) {
        #text-bubbles {
            display: none;
        }
    }
</style>
<script>
    declare global {
        interface Window {
            textBubblesInitialized?: boolean;
        }
    }

    const prefersReduced =
        window.matchMedia &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!window.textBubblesInitialized && !prefersReduced) {
        window.textBubblesInitialized = true;

        const interests = [
            "Jazz",
            "Hospitality",
            "Community",
            "Environment",
            "Philanthropy",
            "Innovation",
            "Culture",
            "Food",
            "Sustainability",
            "Philadelphia",
            "Education",
            "Technology",
            "Art",
            "Music",
            "Storytelling",
            "Film",
            "Development",
        ];

        const MAX_BUBBLES = 8;

        function generateRandom(min = 0, max = 100) {
            return Math.floor(Math.random() * (max - min)) + min;
        }

        let creationTimeout: ReturnType<typeof setTimeout> | undefined;
        let running = false;

        function clearBubbles() {
            const bubbles = document.getElementById("text-bubbles");
            if (!bubbles) return;
            Array.from(bubbles.children).forEach((child) => {
                if (child.id !== "template-bubble") {
                    bubbles.removeChild(child);
                }
            });
        }

        function createBubble(
            bubbles: HTMLElement,
            template: HTMLTemplateElement,
        ) {
            const index = Math.floor(Math.random() * interests.length);
            const interest: string = interests[index] || "Innovation";
            const bubbleNode = template.content.cloneNode(
                true,
            ) as DocumentFragment;
            const bubbleElement = bubbleNode.querySelector(
                "div",
            ) as HTMLDivElement | null;

            if (!bubbleElement) return;

            bubbleElement.textContent = interest;

            const textLength = interest.length;
            const isMobile = window.innerWidth <= 768;
            const scaleFactor = isMobile ? 0.6 : 1;
            const baseSize = Math.max(textLength * 1.2, 6) * scaleFactor;
            const sizePx = Math.min(baseSize * 10, window.innerWidth * 0.2);

            bubbleElement.style.width = sizePx + "px";
            bubbleElement.style.height = sizePx + "px";
            bubbleElement.style.fontSize =
                Math.max(sizePx * 0.15, isMobile ? 10 : 12) + "px";
            bubbleElement.style.left =
                generateRandom(0, Math.max(1, window.innerWidth - sizePx)) +
                "px";

            const duration = generateRandom(16000, 22000);
            bubbleElement.style.animationDuration = duration + "ms";
            bubbleElement.style.transform = "translateY(0)";
            bubbles.appendChild(bubbleElement);

            setTimeout(() => bubbleElement.remove(), duration);
        }

        function tick() {
            const bubbles = document.getElementById("text-bubbles");
            const template = document.getElementById(
                "template-bubble",
            ) as HTMLTemplateElement | null;
            if (!bubbles || !template || !running) return;

            if (document.querySelectorAll(".bubble").length < MAX_BUBBLES) {
                createBubble(bubbles, template);
            }
            creationTimeout = setTimeout(tick, generateRandom(1600, 2800));
        }

        function start() {
            if (running) return;
            running = true;
            tick();
        }

        function stop() {
            running = false;
            clearTimeout(creationTimeout);
        }

        let resizeTimeout: ReturnType<typeof setTimeout>;
        window.addEventListener("resize", () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(clearBubbles, 250);
        });

        document.addEventListener("visibilitychange", () => {
            if (document.hidden) {
                stop();
            } else {
                start();
            }
        });

        start();
    }
</script>
