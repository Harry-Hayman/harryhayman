---
import { Image } from "astro:assets";
import harryImage from "../assets/data/harryhayman images/harryhayman_bg_removed.png";
import anotherThreeHeartsLogo from "../assets/data/business_logo/another_three_hearts_experience.png";
import feedPhillyLogo from "../assets/data/business_logo/feed_philly_coalition.png";
import geminiLogo from "../assets/data/business_logo/gemini_hospitality_consulting.png";
import creativelogo from "../assets/data/business_logo/harry_hayman_creative.png";
import iAmHungryLogo from "../assets/data/business_logo/i_am_hungry.jpg";
import jazzLogo from "../assets/data/business_logo/philadelphia_jazz_experience.png";
import veggieGraffitiLogo from "../assets/data/business_logo/veggie_graffiti.png";

const businesses = [
  {
    name: "Another Three Hearts Experience",
    logo: anotherThreeHeartsLogo,
    url: "https://another3heartsexperience.com",
  },
  {
    name: "Feed Philly Coalition",
    logo: feedPhillyLogo,
    url: "https://feedphillycoalition.org",
  },
  {
    name: "Gemini Hospitality Consulting",
    logo: geminiLogo,
    url: "https://geminihospitalityconsultants.com",
  },
  {
    name: "Harry Hayman Creative",
    logo: creativelogo,
    url: "https://harryhaymancreative.com",
  },
  {
    name: "I Am Hungry in Philly",
    logo: iAmHungryLogo,
    url: "https://iamhungryinphilly.com",
  },
  {
    name: "Philadelphia Jazz Experience",
    logo: jazzLogo,
    url: "https://philadelphiajazzexperience.org",
  },
  {
    name: "Veggie Graffiti",
    logo: veggieGraffitiLogo,
    url: "https://veggiegraffiti.com",
  },
];

// Calculate position based on index
const getCoordinates = (index: number, radius: number) => {
  const angle = (index * (360 / businesses.length) * Math.PI) / 180;
  return {
    x: 50 + Math.cos(angle) * radius,
    y: 50 + Math.sin(angle) * radius,
  };
};
---

<div
  class="relative overflow-hidden radial-diagram"
  data-aos="zoom-in"
  data-aos-duration="1000"
>
  <style>
    /*
     * Staggered reveal without GSAP. The library plus ScrollTrigger was ~73 KB
     * of JavaScript loaded on every page for this one component; the same
     * effect is a CSS transition driven by the shared IntersectionObserver.
     */
    /* Opacity only: these nodes carry their own translate transforms for
       positioning, so animating transform here would move them off-centre. */
    .business-logo,
    .center-image,
    .animated-line {
      opacity: 0;
      transition: opacity 0.5s ease-out;
    }

    .radial-diagram.is-revealed .business-logo,
    .radial-diagram.is-revealed .center-image {
      opacity: 1;
    }

    .radial-diagram.is-revealed .animated-line {
      opacity: 0.6;
    }

    @media (prefers-reduced-motion: reduce) {
      .business-logo,
      .center-image {
        opacity: 1;
        transition: none;
      }
      .animated-line {
        opacity: 0.6;
        transition: none;
      }
    }
  </style>
  <script>
    (function () {
      const diagram = document.querySelector(".radial-diagram");
      if (!diagram) return;

      // Stagger each satellite so the diagram assembles rather than pops.
      diagram.querySelectorAll<HTMLElement>(".business-logo").forEach(
        (logo, index) => {
          logo.style.transitionDelay = 150 + index * 90 + "ms";
        },
      );
      diagram.querySelectorAll<HTMLElement>(".animated-line").forEach(
        (line, index) => {
          line.style.transitionDelay = 150 + index * 90 + "ms";
        },
      );

      const reveal = () => diagram.classList.add("is-revealed");

      if (!("IntersectionObserver" in window)) {
        reveal();
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              reveal();
              io.disconnect();
            }
          });
        },
        { threshold: 0.1 },
      );
      io.observe(diagram);
    })();
  </script>
  <!-- Fixed aspect ratio container -->
  <div class="mx-auto" style="width: min(100%, 800px);">
    <div class="relative" style="padding-bottom: 100%;">
      <!-- Content container -->
      <div class="absolute inset-0">
        <!-- Connecting Lines -->
        <div class="absolute inset-0" style="transform: scale(0.85);">
          <style>
            @keyframes dash {
              to {
                stroke-dashoffset: -20;
              }
            }
            .animated-line {
              animation: dash 1.5s linear infinite;
              stroke: rgb(var(--brand-500));
            }
            :global(:root.dark) .animated-line {
              stroke: rgb(var(--brand-400));
            }
            @media (prefers-reduced-motion: reduce) {
              .animated-line {
                animation: none;
              }
            }
          </style>
          {
            businesses.map((_, index) => {
              const inner = getCoordinates(index, 15);
              const outer = getCoordinates(index, 40);

              return (
                <svg class="absolute inset-0 w-full h-full overflow-visible pointer-events-none">
                  <line
                    x1={`${inner.x}%`}
                    y1={`${inner.y}%`}
                    x2={`${outer.x}%`}
                    y2={`${outer.y}%`}
                    stroke="#2E8BE0"
                    stroke-width="1.5"
                    stroke-dasharray="4,7"
                    stroke-linecap="round"
                    class="animated-line"
                  />
                </svg>
              );
            })
          }
        </div>

        <!-- Center Image -->
        <div
          class="absolute left-1/2 top-[52%] -translate-x-1/2 -translate-y-1/2 w-[25%] aspect-square z-20 center-image"
        >
          <div class="relative w-full h-full">
            <div
              class="absolute inset-0 rounded-full overflow-hidden border-2 border-[rgb(var(--brand-500))] bg-white shadow-2 ring-8 ring-[rgb(var(--accent-soft))]"
            >
              <Image
                src={harryImage}
                alt="Harry Hayman"
                class="w-full h-full object-contain"
                width={150}
                height={150}
                format="webp"
                quality={72}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </div>
          </div>
          <!-- Harry's name. Hidden on narrow screens, where it collided with
               the satellite logos and duplicated the page heading below. -->
          <div
            class="absolute -bottom-9 left-1/2 hidden w-max -translate-x-1/2 text-center sm:block"
          >
            <p
              class="whitespace-nowrap font-serif text-base font-bold text-[rgb(var(--text-primary))] md:text-lg"
            >
              Harry Hayman
            </p>
          </div>
        </div>

        <!-- Business Logos -->
        <div class="absolute inset-0" style="transform: scale(0.85);">
          {
            businesses.map((business, index) => {
              const pos = getCoordinates(index, 42);

              return (
                <a
                  href={business.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="absolute w-[18%] aspect-square transition-all duration-300 hover:scale-125 hover:z-20 group cursor-pointer business-logo"
                  style={`left: ${pos.x}%; top: ${pos.y}%; transform: translate(-50%, -50%);`}
                >
                  <div class="relative w-full h-full">
                    <div class="w-full h-full rounded-full overflow-hidden border border-[rgb(var(--nav-border))] bg-white shadow-1 transition-shadow group-hover:shadow-2">
                      <Image
                        src={business.logo}
                        alt={business.name}
                        class="w-full h-full object-contain p-2.5"
                        width={120}
                        height={120}
                        format="webp"
                        quality={72}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="absolute left-1/2 -translate-x-1/2 bg-[rgb(var(--ink-panel))] text-white px-3 py-1.5 rounded-field opacity-0 group-hover:opacity-100 transition-opacity duration-300 -bottom-11 shadow-2 z-30 text-xs whitespace-nowrap text-center">
                      {business.name}
                    </div>
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</div>
