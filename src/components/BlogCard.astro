---
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  href: string;
  image: any | undefined;
  category: string | undefined;
  /** Above-the-fold cards load eagerly; everything else stays lazy. */
  priority?: boolean;
  /** "lead" is the front page's single top story, "standard" is the grid card. */
  variant?: "lead" | "standard";
}

const {
  title,
  description,
  pubDate,
  href,
  image = undefined,
  category = undefined,
  priority = false,
  variant = "standard",
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const isLead = variant === "lead";
---

<article class="card card-link group h-full overflow-hidden">
  <a
    href={href}
    class:list={[
      "flex h-full flex-col",
      isLead && "md:grid md:grid-cols-2 md:items-stretch",
    ]}
  >
    {
      image && (
        <div
          class:list={[
            "relative overflow-hidden",
            isLead ? "h-56 sm:h-72 md:h-full md:min-h-[21rem]" : "h-44 sm:h-48",
          ]}
        >
          <Image
            src={image}
            alt=""
            class="h-full w-full object-cover transition-transform duration-700 ease-editorial group-hover:scale-[1.04]"
            width={isLead ? 900 : 640}
            height={isLead ? 600 : 360}
            format="webp"
            quality={60}
            loading={priority ? "eager" : "lazy"}
            decoding="async"
            sizes={
              isLead
                ? "(max-width: 768px) 100vw, 560px"
                : "(max-width: 768px) 100vw, 360px"
            }
          />
        </div>
      )
    }
    <div
      class:list={[
        "flex flex-1 flex-col",
        isLead ? "justify-center p-6 sm:p-8 lg:p-10" : "p-5 sm:p-6",
      ]}
    >
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        {
          category && (
            <span class="text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-[rgb(var(--accent))]">
              {category}
            </span>
          )
        }
        <time class="meta text-xs" datetime={pubDate.toISOString()}>
          {formattedDate}
        </time>
      </div>

      <h3
        class:list={[
          "mt-3 text-[rgb(var(--text-primary))] transition-colors group-hover:text-[rgb(var(--accent))]",
          isLead ? "heading-2" : "heading-3",
        ]}
      >
        {title}
      </h3>

      <p
        class:list={[
          "mt-3 flex-grow leading-relaxed text-[rgb(var(--text-secondary))]",
          isLead ? "clamp-3 text-base sm:text-lg" : "clamp-3 text-sm",
        ]}
      >
        {description}
      </p>

      <span class="link-more mt-5 text-sm">
        Read the post
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"
          ></path>
        </svg>
      </span>
    </div>
  </a>
</article>
