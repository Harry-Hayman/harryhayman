---
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  href: string;
  image: any | undefined;
  category: string | undefined;
  /** Above-the-fold cards load eagerly; everything else stays lazy. */
  priority?: boolean;
}

const {
  title,
  description,
  pubDate,
  href,
  image = undefined,
  category = undefined,
  priority = false,
} = Astro.props;
const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article
  class="card group relative flex h-full flex-col overflow-hidden rounded-xl transition-transform duration-300 hover:-translate-y-1"
>
  <a href={href} class="flex h-full flex-col">
    {
      image && (
        <div class="relative h-48 overflow-hidden sm:h-56">
          <Image
            src={image}
            alt={title}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            width={640}
            height={360}
            format="webp"
            quality={58}
            loading={priority ? "eager" : "lazy"}
            decoding="async"
            sizes="(max-width: 768px) 100vw, 480px"
          />
          {category && (
            <span class="absolute left-4 top-4 rounded-full bg-[rgb(var(--button-primary))] px-3 py-1 text-sm font-medium text-[rgb(var(--button-on))]">
              {category}
            </span>
          )}
        </div>
      )
    }
    <div class="flex flex-1 flex-col p-6">
      <h3
        class="mb-2 font-serif text-xl font-bold text-[rgb(var(--text-primary))] transition-colors group-hover:text-[rgb(var(--accent))] sm:text-2xl"
      >
        {title}
      </h3>
      <p class="clamp-2 mb-4 flex-grow text-[rgb(var(--text-secondary))]">
        {description}
      </p>
      <time
        class="text-sm text-[rgb(var(--text-muted))]"
        datetime={pubDate.toISOString()}
      >
        {formattedDate}
      </time>
    </div>
  </a>
</article>

<style>
  .clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
