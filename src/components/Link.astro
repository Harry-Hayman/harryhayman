---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  text: string;
  addClass?: string;
}
const { text, addClass, href, ...props } = Astro.props;

/* Compare without trailing slashes: links use the canonical `/blog/` form,
   while the dev server reports `/blog` and production `/blog/`. */
const trim = (value: string) => value.replace(/\/+$/, "");
const path = trim(Astro.url.pathname);
const rawTarget = typeof href === "string" ? href : href?.href;
const target = rawTarget === undefined ? undefined : trim(rawTarget);

let isActive = false;
if (target === "") {
  isActive = path === "";
} else if (target) {
  isActive = path === target || path.startsWith(target + "/");
}
---

<a
  class:list={["nav-link text-sm sm:text-base", addClass]}
  aria-current={isActive ? "page" : undefined}
  href={href}
  {...props}
>
  {text}
</a>
