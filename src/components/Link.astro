---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  text: string;
  addClass?: string;
}
const { text, addClass, href, ...props } = Astro.props;

const path = Astro.url.pathname;
const target = typeof href === "string" ? href : href?.href;

let isActive = false;
if (target === "/") {
  isActive = path === "/" || path === "";
} else if (target) {
  isActive = path === target || path.startsWith(target + "/");
}
---

<a
  class:list={["nav-link text-sm sm:text-base", addClass]}
  aria-current={isActive ? "page" : undefined}
  href={href}
  {...props}
>
  {text}
</a>
