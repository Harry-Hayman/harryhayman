---
import { Image } from "astro:assets";
import type { Venture } from "@data/ventures";

interface Props extends Venture {
  /** "feature" = large card with imagery, "compact" = index row with a logo tile. */
  variant?: "feature" | "compact";
  index: number;
}

const {
  title,
  sector,
  description,
  image,
  kind,
  website,
  linkedin,
  instagram,
  facebook,
  twitter,
  variant = "feature",
  index,
} = Astro.props;

/*
 * The globe icon used to duplicate the "Visit" link directly above it, so it
 * is gone. What is left is one quiet row of the places each venture actually
 * publishes, at a size that does not compete with the venture's name.
 */
const socials = [
  {
    label: "LinkedIn",
    href: linkedin,
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  {
    label: "Instagram",
    href: instagram,
    path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z",
  },
  {
    label: "Facebook",
    href: facebook,
    path: "M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z",
  },
  {
    label: "X",
    href: twitter,
    path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  },
];

const num = String(index + 1).padStart(2, "0");
---

{
  variant === "feature" ? (
    <article class="card card-link group flex h-full flex-col overflow-hidden">
      <div class="relative block aspect-[16/10] overflow-hidden">
        <div class:list={["h-full w-full", kind === "photo" && "duotone"]}>
          <Image
            src={image}
            alt=""
            class="h-full w-full object-cover transition-transform duration-700 ease-editorial group-hover:scale-[1.04]"
            width={720}
            height={450}
            format="webp"
            quality={64}
            loading="lazy"
            decoding="async"
            sizes="(max-width: 768px) 100vw, 560px"
          />
        </div>
        <span class="absolute left-4 top-4 inline-flex items-center rounded-chip bg-[rgb(var(--ink-panel))] px-2.5 py-1 text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-white">
          {sector}
        </span>
      </div>

      <div class="flex flex-1 flex-col p-6 sm:p-7">
        <p class="index-num">{num}</p>
        <h3 class="heading-3 mt-2 text-[rgb(var(--text-primary))]">
          <a
            href={website}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-[rgb(var(--accent))]"
          >
            {title}
          </a>
        </h3>
        <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-[rgb(var(--text-secondary))]">
          {description}
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-[rgb(var(--nav-border))] pt-4">
          <a
            href={website}
            target="_blank"
            rel="noopener noreferrer"
            class="link-more"
          >
            Visit the site
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 6H18v4.5M17.5 6.5 10 14M16 13.5V18H6V8h4.5"
              />
            </svg>
          </a>
          <ul class="flex items-center gap-0.5">
            {socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${title} on ${social.label}`}
                  title={`${title} on ${social.label}`}
                  class="inline-flex h-9 w-9 items-center justify-center rounded-field text-[rgb(var(--text-muted))] transition-colors hover:bg-[rgb(var(--accent-soft))] hover:text-[rgb(var(--accent))]"
                >
                  <svg
                    class="h-4 w-4"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d={social.path} />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </article>
  ) : (
    <article class="panel group flex h-full gap-4 p-5 transition-colors hover:border-[rgb(var(--brand-400))] sm:gap-5 sm:p-6">
      <div class="shrink-0">
        <div class="flex h-20 w-20 items-center justify-center overflow-hidden rounded-field border border-[rgb(var(--nav-border))] bg-white p-2 shadow-1 sm:h-24 sm:w-24">
          <Image
            src={image}
            alt=""
            class="h-full w-full object-contain"
            width={160}
            height={160}
            format="webp"
            quality={72}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-[rgb(var(--accent))]">
          {sector}
        </p>
        <h3 class="heading-3 mt-1.5 text-[rgb(var(--text-primary))]">
          <a
            href={website}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-[rgb(var(--accent))]"
          >
            {title}
          </a>
        </h3>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-[rgb(var(--text-secondary))]">
          {description}
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
          <a
            href={website}
            target="_blank"
            rel="noopener noreferrer"
            class="link-more text-sm"
          >
            Visit the site
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 6H18v4.5M17.5 6.5 10 14M16 13.5V18H6V8h4.5"
              />
            </svg>
          </a>
          <ul class="flex items-center gap-0.5">
            {socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${title} on ${social.label}`}
                  title={`${title} on ${social.label}`}
                  class="inline-flex h-8 w-8 items-center justify-center rounded-field text-[rgb(var(--text-muted))] transition-colors hover:bg-[rgb(var(--accent-soft))] hover:text-[rgb(var(--accent))]"
                >
                  <svg
                    class="h-[15px] w-[15px]"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d={social.path} />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </article>
  )
}
